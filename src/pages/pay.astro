---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import CTABand from '../components/sections/CTABand.astro';
---
<BaseLayout
  title="Payment Links Are Sent by Apex | Apex Packaging Solutions"
  description="Apex Packaging Solutions sends secure fixed-amount Stripe checkout links privately after quote approval."
  noindex
>
  <PageHeader
    eyebrow="Quote approval required"
    heading="Payment links are created for approved orders only."
    lead="For security, Apex no longer accepts arbitrary public payment amounts on this website. The sales team creates a secure fixed-amount Stripe checkout link and sends it directly to the customer after quote approval."
  />

  <CTABand
    heading="Ready to pay an approved quote?"
    lead="Email or call Apex with the quote or invoice number and the team will issue the secure payment link privately."
    primaryCta={{ label: 'Email Apex', href: 'mailto:sales@apexpackagingsolutions.com' }}
    secondaryCta={{ label: 'Contact page', href: '/contact' }}
  />
</BaseLayout>
