---
import PackagingBanner from '../components/sections/PackagingBanner.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PackagingIcon from '../components/ui/PackagingIcon.astro';
import TrustedClients from '../components/trust/TrustedClients.astro';
import GoogleReviews from '../components/trust/GoogleReviews.astro';
import QuoteFormFeedback from '../components/forms/QuoteFormFeedback.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import { buildFAQSchema } from '../lib/schema';
import { featuredIndustryBoxes } from '../data/industryBoxes';
import { siteConfig } from '../site.config';

const categories = featuredIndustryBoxes.map((box) => ({
  title: box.slug === 'auto-parts' ? 'Auto Parts Boxes' : box.label,
  href: `/industries/${box.slug}`,
  image: box.image,
  alt: box.alt
}));

const benefitStrip = [
  { step: 'Quote', title: 'Project-Specific Setup', stat: 'Quoted clearly', icon: 'quote-review', body: 'Tooling, plate, and setup requirements are confirmed for the selected structure, print method, and quantity.' },
  { step: 'Proof', title: 'Design Support', stat: 'Scope confirmed', icon: 'design-proof', body: 'Dieline, artwork-preparation, proof, and mockup support is scoped after Apex reviews the project brief.' },
  { step: 'Sample', title: 'Project-Specific Samples', stat: 'Validate first', icon: 'sample-run', body: 'Available digital or physical sample options, costs, and timing are confirmed for the selected specification.' },
  { step: 'Specify', title: 'Customize Size & Style', stat: 'Built to fit', icon: 'custom-spec', body: 'Boxes, bags, trays, sleeves, inserts, and finishes built around your product.' },
  { step: 'Produce', title: 'Managed Production', stat: 'Qualified facilities', icon: 'production-window', body: 'Apex coordinates approved projects through qualified overseas production facilities.' },
  { step: 'Ship', title: 'Doorstep Delivery', stat: 'Global service', icon: 'domestic-shipping', body: 'Shipping is coordinated for Canada, the United States, and international destinations.' }
];

const finishes = [
  { title: 'Holographic Foiling', image: 'holographic-foiling', href: '/packaging-finishes/holographic-foiling' },
  { title: 'Gold Foiling', image: 'gold-foiling', href: '/packaging-finishes/gold-foiling' },
  { title: 'Embossing', image: 'embossing' },
  { title: 'Matte Lamination', image: 'matte-lamination' },
  { title: 'Spot UV', image: 'spot-uv' },
  { title: 'Soft Touch', image: 'soft-touch' }
];

const reasons = [
  { title: 'Customize Size and Shape', icon: 'custom-size-shape', body: 'Apex develops each packaging specification around the product dimensions, retail channel, and shipping environment.' },
  { title: 'Material Options', icon: 'sustainable-materials', body: 'Material, recycled-content, food-contact, and end-of-life requirements are reviewed for the exact project.' },
  { title: 'High-End Printing Quality', icon: 'printing-quality', body: 'Flexo, digital, and litho-laminated print options cover short runs, retail graphics, and industrial markings.' },
  { title: 'Premium Finishing Features', icon: 'premium-finishes', body: 'Foil, embossing, spot UV, matte lamination, and soft-touch finishes help retail packaging stand out.' },
  { title: 'Coordinated Delivery', icon: 'canadian-delivery', body: 'Shipping options, delivery terms, and timing are confirmed in the product-specific quotation.' },
  { title: 'Design Support Available', icon: 'design-support', body: 'Send the information and assets you have; Apex will confirm the dieline, proof, artwork-preparation, and approval support appropriate to the project.' },
  { title: 'Product-Specific Minimums', icon: 'low-moq', body: 'Minimum order quantities are confirmed for the selected style, material, print method, quantity, and destination.' },
  { title: 'Procurement-Ready Specs', icon: 'procurement-specs', body: 'Quotes include material, board strength, print method, MOQ, lead time, and reorder details.' }
];

const topBenefits = [
  { title: 'Custom Made', body: 'Tailored to your brand', icon: 'custom-spec' },
  { title: 'Custom Quotations', body: 'Built around your specification', icon: 'low-moq' },
  { title: 'Material Options', body: 'Confirmed per project', icon: 'sustainable-materials' },
  { title: 'Expert Support', body: "We're here to help", icon: 'design-support' },
  { title: 'Global Shipping', body: 'Delivering worldwide', icon: 'domestic-shipping' }
];

const faqs = [
  { q: 'What details should I provide for a custom packaging quote?', a: 'Share the product and intended use, packed dimensions and weight, quantity, artwork status, print or finish needs, delivery destination, and target timing.' },
  { q: 'Which types of custom packaging can Apex supply?', a: 'Apex coordinates folding cartons, corrugated mailers and shippers, rigid boxes, retail and display packaging, gift packaging, bags, and pouches to an approved project specification.' },
  { q: 'Can I request a quote if I do not know the final size or material?', a: 'Yes—send the product dimensions, weight, photos, intended use, quantity, and destination, and Apex will help define the structure and material requirements.' },
  { q: 'How should I measure my product for custom packaging?', a: 'Measure the packed product at its longest, widest, and tallest points, then include the space needed for inserts, cushioning, assembly, and safe removal.' },
  { q: 'What is the minimum order quantity?', a: 'Minimums are product-specific and depend on the structure, material, print method, finishes, tooling, and production process; the quotation confirms the applicable quantity.' },
  { q: 'What affects the price of custom packaging?', a: 'Price is shaped by dimensions, material, structure, print coverage, finishes, inserts, quantity, sampling, freight, and the delivery destination.' },
  { q: 'Can I review a proof or sample before production?', a: 'Yes—Apex confirms the available digital proof or physical sample option, cost, and timing for the selected specification before production approval.' },
  { q: 'What artwork files should I provide?', a: 'Send editable AI or EPS files or a print-ready PDF when available, plus linked images, fonts, colour references, and any existing dieline; Apex will confirm the final prepress requirements.' },
  { q: 'Can Apex match brand colours and add premium finishes?', a: 'Apex can review colour references and quote suitable foil, embossing, spot UV, lamination, or other finishes for the approved material and structure.' },
  { q: 'How long do production and delivery take?', a: 'The schedule depends on structure, material, quantity, artwork and sample approvals, production method, freight, and destination, so Apex confirms production and transit timing in the quotation.' },
  { q: 'How do I choose recyclable or lower-impact packaging?', a: 'Start with protection, barrier, food-contact, shipping, and local recovery needs, then request material, recycled-content, certification, and end-of-life documentation for the exact specification.' },
  { q: 'Does Apex serve businesses across Canada and the United States?', a: 'Yes—Apex is based in Canada and coordinates approved packaging projects through qualified overseas production facilities for delivery across Canada, the United States, and international markets.' }
];

const schemaBlocks = [buildFAQSchema(faqs)];
const approvedClientLogos = [];
const responsiveImagePath = (src: string, width: number) => src.replace(/\.(webp|png|jpe?g)$/i, `-${width}.webp`);
const responsiveImageSrcset = (src: string, widths: number[]) => widths.map((width) => `${responsiveImagePath(src, width)} ${width}w`).join(', ');
---
<BaseLayout
  title="Custom Boxes & Printed Packaging Canada | Apex"
  description="Canada-based Apex supplies custom boxes, printed packaging, mailers, rigid boxes, pouches and bags, with US service available. Request a project quote."
  schemaBlocks={schemaBlocks}
>
  <PackagingBanner />

  <section class="apex-benefit-strip border-y border-[#e1b84d]/30 bg-[#061a2e]">
    <div class="container max-w-wide overflow-hidden">
      <div class="-mx-4 flex snap-x overflow-x-auto [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-5 md:overflow-visible [&::-webkit-scrollbar]:hidden">
        {topBenefits.map((item) => (
          <div class="flex min-h-24 min-w-[17rem] snap-start items-center gap-3 border-r border-[#e1b84d]/20 px-5 py-5 last:border-r-0 md:min-w-0 md:px-6">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#e1b84d] text-[#061a2e] shadow-[0_0_0_3px_rgba(225,184,77,0.16)]">
              <PackagingIcon name={item.icon} class="h-5 w-5" />
            </span>
            <span>
              <strong class="block font-display text-sm font-extrabold text-[#f6ce62] md:text-base">{item.title}</strong>
              <span class="mt-1 block text-xs font-semibold text-[#eec252] md:text-sm">{item.body}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="categories" class="bg-[#fffdf8] py-12 md:py-24">
    <div class="container max-w-wide">
      <div class="mx-auto mb-8 max-w-4xl text-center md:mb-12">
        <h1 class="font-display text-3xl font-extrabold leading-tight text-neutral-900 md:text-5xl">Custom Boxes & Printed Packaging for Canadian Businesses</h1>
        <p class="mx-auto mt-3 max-w-3xl text-base leading-relaxed text-neutral-600 md:mt-4 md:text-lg">
          Apex Packaging Solutions supplies custom printed folding cartons, corrugated and mailer boxes, rigid boxes, display and retail packaging, pouches, and bags for businesses across Canada, with service available in the United States. From its Canada-based project team, Apex coordinates structural design, artwork, proofs, and samples through production with qualified overseas facilities and delivery to the approved destination.
        </p>
        <div class="mt-6 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
          <a href="/contact" class="btn-primary">Request a Quote</a>
          <a href="/industries" class="btn-secondary">Explore Packaging</a>
        </div>
      </div>
      <h2 class="sr-only">Explore custom packaging by product and style</h2>
      <div class="-mx-4 grid auto-cols-[minmax(9rem,42vw)] grid-flow-col grid-rows-2 gap-x-4 gap-y-7 overflow-x-auto px-4 pb-2 [scrollbar-width:none] md:mx-0 md:grid-flow-row md:grid-cols-4 md:gap-x-5 md:gap-y-10 md:overflow-visible md:px-0 md:pb-0 lg:gap-x-8 [&::-webkit-scrollbar]:hidden">
        {categories.map((cat, index) => (
          <a href={cat.href} class:list={['apex-category-card group min-w-0 snap-start text-center', index >= 8 && 'max-md:hidden']}>
            <img
              src={cat.image}
              srcset={responsiveImageSrcset(cat.image, [320, 500, 620])}
              sizes="(max-width: 767px) 42vw, (max-width: 1023px) 25vw, 249px"
              alt=""
              width="418"
              height="418"
              loading="lazy"
              decoding="async"
              class="apex-category-image aspect-square w-full rounded-md border border-neutral-100 object-cover shadow-sm transition duration-200 group-hover:-translate-y-1 group-hover:shadow-card"
            />
            <h3 class="mt-3 font-display text-sm font-extrabold uppercase tracking-normal text-neutral-900 md:mt-5 md:text-xl">{cat.title}</h3>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center md:mt-10">
        <a href="/industries" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">View all packaging categories</a>
        <span class="mx-2 text-neutral-400">·</span>
        <a href="/custom-boxes-with-logo" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">Custom boxes with logo</a>
        <span class="mx-2 text-neutral-400">·</span>
        <a href="/wholesale-custom-boxes" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">Wholesale custom boxes</a>
      </div>
    </div>
  </section>

  <section class="bg-[#f6f1e7] py-12 md:py-24">
    <div class="container max-w-wide">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow">RFQ to reorder</p>
          <h2 class="mt-3 max-w-5xl font-display text-3xl font-extrabold uppercase leading-tight text-neutral-900 md:text-5xl">
            Quote, proof, produce, reorder
          </h2>
          <p class="mt-3 max-w-3xl text-base leading-relaxed text-neutral-600 md:mt-4 md:text-lg">
            Apex brings custom packaging pricing, dielines, materials, production timing, and shipping clarity into one clear workflow.
          </p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <a href="#quote" class="btn-primary !bg-[#c99700] !text-neutral-950 hover:!bg-warning">Start a quote</a>
        </div>
      </div>

      <div class="relative mt-8 md:mt-12">
        <div class="absolute left-0 right-0 top-[46px] hidden h-px bg-neutral-300 lg:block"></div>
        <div class="-mx-4 flex snap-x gap-4 overflow-x-auto px-4 pb-3 [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-6 [&::-webkit-scrollbar]:hidden">
          {benefitStrip.map((item, index) => (
            <article class="apex-benefit-card group relative flex h-full min-h-[320px] w-[82vw] max-w-[22rem] shrink-0 snap-start flex-col rounded-md border border-neutral-200 bg-white p-5 shadow-card transition duration-300 hover:-translate-y-2 hover:border-[#7fb4bb] hover:shadow-popover sm:w-auto sm:max-w-none lg:min-h-[390px]">
              <div class="mb-5 flex items-center justify-between gap-3">
                <span class="grid h-16 w-16 place-items-center rounded-lg border border-[#c8dbdd] bg-[#eef6f6] text-[#1f6672] shadow-sm transition duration-300 group-hover:-translate-y-1 group-hover:border-[#7fb4bb] group-hover:bg-[#e0eff1]">
                  <PackagingIcon name={item.icon} class="h-9 w-9" />
                </span>
                <span class="rounded-md bg-[#eef6f6] px-2.5 py-1 text-xs font-black uppercase tracking-wide text-[#1f6672] transition duration-300 group-hover:bg-[#1f6672] group-hover:text-white">0{index + 1}</span>
              </div>
              <p class="text-xs font-black uppercase tracking-[0.16em] text-neutral-500">{item.step}</p>
              <h3 class="mt-2 font-display text-lg font-extrabold uppercase leading-tight text-neutral-900 lg:min-h-[4.75rem]">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600 lg:min-h-[8.25rem]">{item.body}</p>
              <div class="mt-auto border-t border-neutral-200 pt-4 text-sm font-black uppercase tracking-wide text-success">{item.stat}</div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#fffdf8] py-12 md:py-24">
    <div class="container max-w-wide">
      <div class="mb-8 text-center md:mb-12">
        <h2 class="font-display text-3xl font-extrabold uppercase text-neutral-900 md:text-5xl">Custom packaging finishes and print effects</h2>
        <p class="mt-3 text-base text-neutral-600">Finishing options that give custom boxes a premium retail feel. <a href="/packaging-finishes" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">Explore custom packaging finishes</a>.</p>
      </div>
      <div class="-mx-4 flex snap-x gap-4 overflow-x-auto px-4 pb-3 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:px-0 md:pb-0 [&::-webkit-scrollbar]:hidden">
        {finishes.map((finish) => (
          <a href={finish.href ?? "/packaging-finishes"} class="group relative block w-[82vw] max-w-[24rem] shrink-0 snap-start overflow-hidden rounded-md bg-neutral-900 md:w-auto md:max-w-none">
            <img
              src={`/images/home/finishes/${finish.image}.webp`}
              srcset={responsiveImageSrcset(`/images/home/finishes/${finish.image}.webp`, [480, 640, 768])}
              sizes="(max-width: 767px) 82vw, (max-width: 1023px) 50vw, 33vw"
              alt=""
              width="768"
              height="341"
              loading="lazy"
              decoding="async"
              class="aspect-[16/9] w-full object-cover opacity-85 transition duration-200 group-hover:scale-[1.03] group-hover:opacity-100"
            />
            <h3 class="absolute bottom-4 left-4 font-display text-xl font-extrabold text-neutral-50">{finish.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section
    class="relative overflow-hidden bg-[#061a2e] bg-cover bg-center bg-no-repeat py-12 md:bg-fixed md:py-24"
    style="background-image: url('/images/home/why-choose-parallax-bg.webp');"
  >
    <div class="absolute inset-0 bg-[#041526]/80"></div>
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(4,21,38,0.94)_0%,rgba(4,21,38,0.82)_48%,rgba(4,21,38,0.62)_100%)]"></div>
    <div class="container max-w-wide relative">
      <div class="max-w-4xl">
        <p class="eyebrow">Why Apex</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold text-neutral-50 md:text-6xl">Why businesses choose Apex for custom packaging</h2>
        <p class="mt-3 max-w-2xl text-base font-semibold uppercase tracking-wide text-neutral-200 md:mt-4 md:text-lg">
          Custom packaging support from brief to reorder.
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 md:mt-12 md:gap-5 lg:grid-cols-4">
        {reasons.map((reason) => (
          <div class="rounded-md border border-white/15 bg-neutral-950/58 p-4 shadow-popover backdrop-blur-sm md:min-h-[260px] md:p-5">
            <span class="mb-4 grid h-14 w-14 place-items-center rounded-lg border border-white/15 bg-white/10 text-[#8fd0cf] shadow-card md:mb-5 md:h-[72px] md:w-[72px]">
              <PackagingIcon name={reason.icon} class="h-10 w-10" />
            </span>
            <h3 class="font-display text-lg font-extrabold text-neutral-50 md:text-xl">{reason.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-200 md:mt-3 md:text-base">{reason.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#fffdf8] py-12 md:py-24">
    <div class="container max-w-wide grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <p class="eyebrow">Specification-led support</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold uppercase text-neutral-900 md:text-5xl">A clearer path from concept to production</h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-neutral-600 md:text-lg">Apex coordinates structure, material, printing, artwork, samples, production, freight, and reorder specifications around the actual product and delivery plan.</p>
      </div>
      <div class="grid grid-cols-2 gap-3 md:gap-4 lg:col-span-7">
        {[
          { src: 'corrugated-boxes-branded', alt: 'Branded corrugated shipping boxes in several sizes' },
          { src: 'polybags-branded', alt: 'Custom printed polybags for apparel and soft goods' },
          { src: 'categories/cosmetic-boxes', alt: 'Custom cosmetic cartons with coordinated brand artwork' },
          { src: 'hero-branded-packaging', alt: 'Assorted custom printed product boxes and mailers' }
        ].map((image) => (
          <img
            src={`/images/home/${image.src}.webp`}
            srcset={responsiveImageSrcset(`/images/home/${image.src}.webp`, [320, 640, 960])}
            sizes="(max-width: 767px) 50vw, 25vw"
            alt={image.alt}
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
            class="aspect-square w-full rounded-md object-cover shadow-card md:rounded-full"
          />
        ))}
      </div>
    </div>
  </section>

  <TrustedClients clients={approvedClientLogos} />

  <GoogleReviews />

  <FAQAccordion
    eyebrow="Buyer questions"
    heading="Frequently asked questions about custom packaging"
    intro="Straight answers to the questions buyers ask before requesting a custom packaging quotation."
    variant="rfq"
    faqs={faqs}
  />

  <section id="quote" class="scroll-mt-28 bg-[#f6f1e7] py-12 md:scroll-mt-32 md:py-24">
    <div class="container max-w-wide">
      <div class="mb-8 max-w-4xl md:mb-10">
        <p class="eyebrow">RFQ desk</p>
        <div class="mt-3 flex flex-wrap items-end gap-x-6 gap-y-3">
          <h2 class="font-display text-3xl font-extrabold uppercase leading-none text-neutral-900 md:text-5xl">Request a custom packaging quote</h2>
          <span class="mb-1 rounded-md bg-white px-4 py-2 text-sm font-black uppercase tracking-wide text-success shadow-card">Quote-specific delivery review</span>
        </div>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-neutral-600 md:mt-4 md:text-lg">
          Start with what you know. Final dimensions, material, quantity, and artwork are helpful but not required for the first enquiry. Apex reviews the brief and confirms the information needed to prepare a project-specific quotation.
        </p>
        <p class="mt-3 max-w-2xl text-sm font-semibold text-neutral-700">
          Required to submit: your name, email address, a short project brief, and the human-confirmation checkbox. All other fields are optional.
        </p>
      </div>

      <div class="grid min-w-0 gap-8 xl:grid-cols-12 xl:items-center xl:gap-10">
        <form class="apex-quote-form min-w-0 max-w-full overflow-hidden rounded-[2rem] rounded-tr-[3.75rem] border border-[#d8cba7] bg-[#f6f1e7] shadow-popover xl:col-span-7" action="/api/quote" method="POST" enctype="multipart/form-data" data-quote-form>
          <input type="hidden" name="source" value="Home Quote Form" />
          <input type="hidden" name="redirectTo" value="/thank-you" />
          <label class="hidden" aria-hidden="true">
            Website
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
          <div class="bg-[#c99700] px-5 py-5 text-center md:px-7">
            <h3 class="font-display text-2xl font-extrabold uppercase tracking-wide text-neutral-950 md:text-3xl">Project specifications</h3>
          </div>

          <div class="grid gap-5 p-4 md:p-7">
            <fieldset class="grid gap-3">
              <legend class="mb-1 flex items-center gap-2 font-display text-base font-extrabold text-neutral-800">
                <span class="grid h-6 w-6 place-items-center rounded bg-[#c99700] text-neutral-950" aria-hidden="true">
                  <PackagingIcon name="quote-review" class="h-4 w-4" />
                </span>
                Product Information
              </legend>
              <input class="h-12 border border-transparent bg-white px-4 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="product" placeholder="Product Name (Optional)" aria-label="Product name (optional)" />
            </fieldset>

            <fieldset class="grid gap-3">
              <legend class="mb-1 flex items-center gap-2 font-display text-base font-extrabold text-neutral-800">
                <span class="grid h-6 w-6 place-items-center rounded bg-[#c99700] text-neutral-950" aria-hidden="true">
                  <PackagingIcon name="custom-spec" class="h-4 w-4" />
                </span>
                Select Sizes
              </legend>
              <div class="grid min-w-0 gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,0.82fr)]">
                <input class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="length" placeholder="Length (Optional)" aria-label="Package length (optional)" />
                <input class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="width" placeholder="Width (Optional)" aria-label="Package width (optional)" />
                <input class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="depth" placeholder="Depth (Optional)" aria-label="Package depth (optional)" />
                <select class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-700 focus:border-accent" name="unit" aria-label="Measurement unit (optional)">
                  <option value="">Unit (Optional)</option>
                  <option>inch</option>
                  <option>cm</option>
                  <option>mm</option>
                </select>
              </div>
            </fieldset>

            <fieldset class="grid gap-3">
              <legend class="mb-1 flex items-center gap-2 font-display text-base font-extrabold text-neutral-800">
                <span class="grid h-6 w-6 place-items-center rounded bg-[#c99700] text-neutral-950" aria-hidden="true">
                  <PackagingIcon name="sample-run" class="h-4 w-4" />
                </span>
                Choose Materials
              </legend>
              <div class="grid min-w-0 gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,0.85fr)]">
                <select class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-700 focus:border-accent" name="material" aria-label="Packaging material (optional)">
                  <option value="">Material (Optional)</option>
                  <option>Cardboard Boxes</option>
                  <option>Kraft Boxes</option>
                  <option>Rigid Boxes</option>
                  <option>Corrugated Boxes</option>
                </select>
                <select class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-700 focus:border-accent" name="printing" aria-label="Printing option (optional)">
                  <option value="">Printing (Optional)</option>
                  <option>Full-color exterior</option>
                  <option>Inside and outside print</option>
                  <option>No print</option>
                </select>
                <input class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="quantity" placeholder="Quantity (Optional)" aria-label="Quantity (optional)" />
              </div>
            </fieldset>

            <fieldset class="grid gap-3">
              <legend class="mb-1 flex items-center gap-2 font-display text-base font-extrabold text-neutral-800">
                <span class="grid h-6 w-6 place-items-center rounded bg-[#c99700] text-neutral-950" aria-hidden="true">
                  <PackagingIcon name="design-proof" class="h-4 w-4" />
                </span>
                Upload Artwork
              </legend>
              <label class="flex min-h-12 cursor-pointer items-center bg-white px-4 text-sm font-semibold text-neutral-500 transition hover:ring-1 hover:ring-accent">
                <span class="sr-only">Upload artwork file</span>
                <input
                  class="text-sm"
                  name="artwork"
                  type="file"
                  accept=".pdf,.ai,.eps,.png,.jpg,.jpeg,.webp,application/pdf,application/postscript,image/png,image/jpeg,image/webp"
                  aria-label="Upload artwork file"
                  aria-describedby="home-artwork-help home-artwork-warning"
                  data-artwork-input
                  data-max-bytes="8388608"
                  data-supported-extensions=".pdf,.ai,.eps,.png,.jpg,.jpeg,.webp"
                  data-supported-mime-types=",application/octet-stream,application/pdf,application/postscript,application/illustrator,application/vnd.adobe.illustrator,application/x-illustrator,image/x-eps,image/png,image/jpeg,image/pjpeg,image/webp"
                  data-artwork-email={siteConfig.email}
                />
              </label>
              <p id="home-artwork-help" class="text-xs font-medium text-neutral-600">PDF, AI, EPS, PNG, JPG, JPEG or WEBP. Maximum 8 MB.</p>
              <p id="home-artwork-warning" class="hidden text-sm font-bold text-[#7a271a]" role="status" aria-live="polite" data-artwork-warning></p>
            </fieldset>

            <fieldset class="grid gap-3">
              <legend class="mb-1 flex items-center gap-2 font-display text-base font-extrabold text-neutral-800">
                <span class="grid h-6 w-6 place-items-center rounded bg-[#c99700] text-neutral-950" aria-hidden="true">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z"></path>
                  </svg>
                </span>
                Required Contact Information
              </legend>
              <div class="grid min-w-0 gap-2 sm:grid-cols-3">
                <input required class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="name" placeholder="Full Name*" autocomplete="name" aria-label="Full name" />
                <input required class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="email" placeholder="Email ID*" type="email" autocomplete="email" aria-label="Email address" />
                <input class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="phone" placeholder="Contact Number (Optional)" type="tel" autocomplete="tel" aria-label="Contact number (optional)" />
              </div>
              <input class="h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="country" placeholder="Country (Optional)" autocomplete="country-name" aria-label="Country" />
            </fieldset>

            <fieldset class="grid gap-3">
              <legend class="mb-1 flex items-center gap-2 font-display text-base font-extrabold text-neutral-800">
                <span class="grid h-6 w-6 place-items-center rounded bg-[#c99700] text-neutral-950" aria-hidden="true">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M11 7h2v2h-2Zm0 4h2v6h-2Zm1-9a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2Z"></path>
                  </svg>
                </span>
                Required Project Brief
              </legend>
              <textarea required class="min-h-28 border border-transparent bg-white px-4 py-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="message" placeholder="What packaging do you need?*" aria-label="Project details"></textarea>
            </fieldset>

            <label class="flex min-h-12 items-center gap-3 rounded-md border border-[#d8cba7] bg-white px-4 text-sm font-bold text-neutral-800">
              <input class="h-5 w-5 accent-[#1f6672]" type="checkbox" name="humanConfirmation" value="confirmed" required />
              <span>I am not a robot</span>
            </label>

            <QuoteFormFeedback />

            <div class="flex justify-end pt-1">
              <button class="min-h-12 rounded-md bg-[#c99700] px-10 py-3 font-black text-neutral-950 transition hover:bg-warning" type="submit">Submit</button>
            </div>
            <p class="text-sm leading-relaxed text-neutral-600">
              After a successful submission, keep the reference shown on screen. Apex will review the brief and use your email address to confirm missing specifications and the next quotation step. Submission does not create a pricing or delivery commitment.
            </p>
          </div>
        </form>

        <aside class="min-w-0 xl:col-span-5">
          <div class="max-w-2xl">
            <h3 class="font-display text-3xl font-extrabold leading-tight text-neutral-900 md:text-4xl">
              Packaging support for your product and brand
            </h3>
            <p class="mt-5 text-base font-semibold leading-relaxed text-neutral-600">
              Ensuring the perfect fit, protection, branding, and presentation for your custom boxes is effortless with Apex's comprehensive support.
            </p>
            <p class="mt-4 text-base font-semibold leading-relaxed text-neutral-600">
              Get expert guidance, access proven box styles, and find the right size by sending your product details. Apex helps select materials, printing techniques, finishes, laminations, and add-ons tailored to your packaging needs and purpose.
            </p>
            <h4 class="mt-7 font-display text-xl font-extrabold text-neutral-900">Artwork and brand preparation</h4>
            <p class="mt-3 text-base font-semibold leading-relaxed text-neutral-600">
              Upload your logo or artwork, and our packaging designers can refine it to match your brand identity while keeping the structure practical for production.
            </p>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {[
                'New look for your brand',
                'Perfect fit to your products',
                'Perfect fit to your purpose',
                'All with convenience quick'
              ].map((item) => (
                <div class="flex min-h-16 items-center gap-3 rounded-md border border-[#ead58d] bg-[#fff8df] px-4 font-display text-sm font-extrabold text-neutral-800">
                  <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[#c99700] text-neutral-950" aria-hidden="true">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m6 12 4 4 8-8"></path>
                    </svg>
                  </span>
                  {item}
                </div>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-[#fffdf8] py-12 md:py-24">
    <div class="container max-w-wide">
      <h2 class="font-display text-2xl font-extrabold text-neutral-900 md:text-4xl">Custom Boxes with Logo for Product and Retail Programs</h2>
      <p class="mt-4 max-w-5xl text-base leading-relaxed text-neutral-600 md:mt-5 md:text-lg">
        Apex Packaging Solutions is a Canada-based custom packaging company providing custom boxes, rigid packaging, corrugated mailers, flexible pouches, paper bags and retail packaging for businesses across Canada, the United States and international markets. Through qualified overseas production facilities, Apex manages each project from structural design, artwork and sampling through production and delivery. See <a href="/custom-boxes-with-logo" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">custom boxes with logo</a> or plan <a href="/wholesale-custom-boxes" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">wholesale custom boxes</a> around your project specification.
      </p>
    </div>
  </section>

  <section class="bg-[#061a2e] py-10 text-neutral-50">
    <div class="container max-w-wide -mx-4 flex snap-x gap-4 overflow-x-auto px-4 [scrollbar-width:none] md:mx-auto md:grid md:grid-cols-5 md:overflow-visible md:px-10 [&::-webkit-scrollbar]:hidden">
      {categories.slice(-5).map((cat) => (
        <a href={cat.href} class="w-[48vw] max-w-[13rem] shrink-0 snap-start text-center md:w-auto md:max-w-none">
          <img
            src={cat.image}
            srcset={responsiveImageSrcset(cat.image, [320, 500, 620])}
            sizes="(max-width: 767px) 48vw, 13rem"
            alt=""
            width="418"
            height="418"
            loading="lazy"
            decoding="async"
            class="aspect-square w-full rounded-md object-cover md:rounded-none"
          />
          <span class="mt-3 block font-display text-sm font-bold md:text-lg">{cat.title}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

