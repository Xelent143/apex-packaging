---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackagingIcon from '../components/ui/PackagingIcon.astro';
import RFQForm from '../components/forms/RFQForm.astro';
import TrustedClients from '../components/trust/TrustedClients.astro';
import { buildFAQSchema } from '../lib/schema';
import { featuredIndustryBoxes } from '../data/industryBoxes';

const categories = featuredIndustryBoxes.map((box) => ({
  title: box.slug === 'auto-parts' ? 'Auto Parts Boxes' : box.label,
  href: `/industries/${box.slug}`,
  image: box.image,
  alt: box.alt
}));

const benefitStrip = [
  { step: 'Quote', title: 'No Die & Plate Charges', stat: 'No setup drag', icon: 'quote-review', body: 'Digital proofs and low-run production keep the first order simple.' },
  { step: 'Proof', title: 'Free Design Support', stat: 'Dieline included', icon: 'design-proof', body: 'Dielines, print prep, and mockups are included with qualifying orders.' },
  { step: 'Sample', title: 'Product-Specific Samples', stat: 'Validate first', icon: 'sample-run', body: 'Digital or physical samples help validate fit, print, and finish before a production run.' },
  { step: 'Specify', title: 'Customize Size & Style', stat: 'Built to fit', icon: 'custom-spec', body: 'Boxes, bags, trays, sleeves, inserts, and finishes built around your product.' },
  { step: 'Produce', title: 'Managed Production', stat: 'Qualified facilities', icon: 'production-window', body: 'Apex coordinates approved projects through qualified overseas production facilities.' },
  { step: 'Ship', title: 'Doorstep Delivery', stat: 'Global service', icon: 'domestic-shipping', body: 'Shipping is coordinated for Canada, the United States, and international destinations.' }
];

const finishes = [
  { title: 'Holographic Foiling', image: 'holographic-foiling' },
  { title: 'Gold Foiling', image: 'gold-foiling' },
  { title: 'Embossing', image: 'embossing' },
  { title: 'Matte Lamination', image: 'matte-lamination' },
  { title: 'Spot UV', image: 'spot-uv' },
  { title: 'Soft Touch', image: 'soft-touch' }
];

const reasons = [
  { title: 'Customize Size and Shape', icon: 'custom-size-shape', body: 'Apex develops each packaging specification around the product dimensions, retail channel, and shipping environment.' },
  { title: 'Material Options', icon: 'sustainable-materials', body: 'Material, recycled-content, food-contact, and end-of-life requirements are reviewed for the exact project.' },
  { title: 'High-End Printing Quality', icon: 'printing-quality', body: 'Flexo, digital, and litho-laminated print options cover short runs, retail graphics, and industrial markings.' },
  { title: 'Premium Finishing Features', icon: 'premium-finishes', body: 'Foil, embossing, spot UV, matte lamination, and soft-touch finishes help retail packaging stand out.' },
  { title: 'Coordinated Delivery', icon: 'canadian-delivery', body: 'Shipping options, delivery terms, and timing are confirmed in the product-specific quotation.' },
  { title: 'Design Support Included', icon: 'design-support', body: 'Send your logo and product dimensions; Apex returns a dieline, proof, and production-ready artwork.' },
  { title: 'Product-Specific Minimums', icon: 'low-moq', body: 'Minimum order quantities are confirmed for the selected style, material, print method, quantity, and destination.' },
  { title: 'Procurement-Ready Specs', icon: 'procurement-specs', body: 'Quotes include material, board strength, print method, MOQ, lead time, and reorder details.' }
];

const topBenefits = [
  { title: 'Custom Made', body: 'Tailored to your brand', icon: 'custom-spec' },
  { title: 'Custom Quotations', body: 'Built around your specification', icon: 'low-moq' },
  { title: 'Material Options', body: 'Confirmed per project', icon: 'sustainable-materials' },
  { title: 'Expert Support', body: "We're here to help", icon: 'design-support' },
  { title: 'Global Shipping', body: 'Delivering worldwide', icon: 'domestic-shipping' }
];

const faqs = [
  { q: 'What is the minimum order quantity?', a: 'Minimum order quantities vary by packaging style, size, material, printing method, quantity, and delivery destination. Contact Apex for a product-specific quotation.' },
  { q: 'What is the typical lead time?', a: 'Production and shipping timelines vary by packaging style, dimensions, material, printing method, quantity, approvals, and delivery destination. Apex confirms the schedule in each product-specific quotation.' },
  { q: 'Can Apex help with artwork and dielines?', a: 'Yes. Apex can create the dieline, prepare artwork, generate a proof, and keep the final files on record for reorders.' }
];

const heroSlides = [
  {
    src: '/images/apex-update/banners/banner-1.webp',
    alt: 'Custom packaging collection with fictional brand designs'
  },
  {
    src: '/images/apex-update/banners/banner-2.webp',
    alt: 'Colorful retail packaging with original mock brands'
  },
  {
    src: '/images/apex-update/banners/banner-3.webp',
    alt: 'Sustainable packaging with fictional brand artwork'
  },
  {
    src: '/images/home/hero-slides/category-showcase-1.webp',
    alt: 'Retail packaging category mockups with cosmetic, bakery, tea, soap, and software box designs'
  },
  {
    src: '/images/home/hero-slides/category-showcase-2.webp',
    alt: 'Food and beverage packaging category mockups with coffee, bakery, food, chocolate, and tea designs'
  },
  {
    src: '/images/home/hero-slides/category-showcase-3.webp',
    alt: 'Premium gift and wellness packaging category mockups with CBD, candle, rigid, pillow, and Christmas box designs'
  },
  {
    src: '/images/home/hero-slides/category-showcase-4.webp',
    alt: 'Custom printed box style mockups with tuck, kraft soap, display, window, and hair extension packaging designs'
  }
];

const heroSlideDurationSeconds = 5;

const schemaBlocks = [buildFAQSchema(faqs)];
const approvedClientLogos = [];
const responsiveImagePath = (src: string, width: number) => src.replace(/\.(webp|png|jpe?g)$/i, `-${width}.webp`);
const responsiveImageSrcset = (src: string, widths: number[]) => widths.map((width) => `${responsiveImagePath(src, width)} ${width}w`).join(', ');
---
<BaseLayout
  title="Custom Packaging Boxes & Custom Boxes Canada | Apex Packaging"
  description="Apex Packaging Solutions supplies custom packaging boxes, custom boxes, printed boxes, mailers, pouches and retail packaging for Canada, the USA and international markets."
  schemaBlocks={schemaBlocks}
>
  <section class="apex-banner-slider overflow-hidden border-b border-[#e2d6bd] bg-[#fffdf8]">
    <div class="relative aspect-[2172/724] w-full">
      {heroSlides.map((slide, index) => (
        <img
          src={slide.src}
          srcset={responsiveImageSrcset(slide.src, [721, 1080, 1442])}
          sizes="100vw"
          alt={slide.alt}
          width="2172"
          height="724"
          class="apex-banner-slide absolute inset-0 h-full w-full object-cover object-center"
          style={`animation-delay: ${index * heroSlideDurationSeconds}s;`}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
      ))}
    </div>
  </section>

  <style>
    .apex-banner-slide {
      animation: apex-banner-fade 35s infinite;
      opacity: 0;
    }

    @keyframes apex-banner-fade {
      0%,
      13% {
        opacity: 1;
      }

      16%,
      94% {
        opacity: 0;
      }

      100% {
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .apex-banner-slide {
        animation: none;
        opacity: 0;
      }

      .apex-banner-slide:first-child {
        opacity: 1;
      }
    }
  </style>

  <section class="apex-benefit-strip border-y border-[#e1b84d]/30 bg-[#061a2e]">
    <div class="container max-w-wide overflow-hidden">
      <div class="-mx-4 flex snap-x overflow-x-auto [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-5 md:overflow-visible [&::-webkit-scrollbar]:hidden">
        {topBenefits.map((item) => (
          <div class="flex min-h-24 min-w-[17rem] snap-start items-center gap-4 border-r border-[#e1b84d]/20 px-5 py-5 last:border-r-0 md:min-w-0 md:px-6">
            <span class="grid h-11 w-11 shrink-0 place-items-center text-[#e1b84d]">
              <PackagingIcon name={item.icon} class="h-10 w-10" />
            </span>
            <span>
              <strong class="block font-display text-sm font-extrabold text-[#e1b84d] md:text-base">{item.title}</strong>
              <span class="mt-1 block text-xs font-semibold text-[#e1b84d]/75 md:text-sm">{item.body}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="categories" class="bg-[#fffdf8] py-12 md:py-24">
    <div class="container max-w-wide">
      <div class="mx-auto mb-8 max-w-4xl text-center md:mb-12">
        <h1 class="font-display text-3xl font-extrabold leading-tight text-neutral-900 md:text-5xl">Custom Packaging Boxes and Custom Boxes in Canada</h1>
        <p class="mx-auto mt-3 max-w-3xl text-base leading-relaxed text-neutral-600 md:mt-4 md:text-lg">
          Custom boxes, custom printed boxes, mailers, bags, rigid boxes, and retail packaging made to fit your product dimensions. Request a custom packaging quote and explore product-specific order options, with design support available for qualifying orders.
        </p>
        <div class="mt-6 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
          <a href="/contact" class="btn-primary">Request a Quote</a>
          <a href="/industries" class="btn-secondary">Explore Packaging</a>
        </div>
      </div>
      <div class="-mx-4 grid auto-cols-[minmax(9rem,42vw)] grid-flow-col grid-rows-2 gap-x-4 gap-y-7 overflow-x-auto px-4 pb-2 [scrollbar-width:none] md:mx-0 md:grid-flow-row md:grid-cols-4 md:gap-x-5 md:gap-y-10 md:overflow-visible md:px-0 md:pb-0 lg:gap-x-8 [&::-webkit-scrollbar]:hidden">
        {categories.map((cat, index) => (
          <a href={cat.href} class:list={['apex-category-card group min-w-0 snap-start text-center', index >= 8 && 'max-md:hidden']}>
            <img
              src={cat.image}
              srcset={responsiveImageSrcset(cat.image, [320, 500, 620])}
              sizes="(max-width: 767px) 42vw, (max-width: 1023px) 25vw, 249px"
              alt={cat.alt}
              width="418"
              height="418"
              loading="lazy"
              decoding="async"
              class="apex-category-image aspect-square w-full rounded-md border border-neutral-100 object-cover shadow-sm transition duration-200 group-hover:-translate-y-1 group-hover:shadow-card"
            />
            <h3 class="mt-3 font-display text-sm font-extrabold uppercase tracking-normal text-neutral-900 md:mt-5 md:text-xl">{cat.title}</h3>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center md:mt-10">
        <a href="/industries" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">View all packaging categories</a>
        <span class="mx-2 text-neutral-400">·</span>
        <a href="/custom-boxes-with-logo" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">Custom boxes with logo</a>
        <span class="mx-2 text-neutral-400">·</span>
        <a href="/wholesale-custom-boxes" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">Wholesale custom boxes</a>
      </div>
    </div>
  </section>

  <section class="bg-[#f6f1e7] py-12 md:py-24">
    <div class="container max-w-wide">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow">RFQ to reorder</p>
          <h2 class="mt-3 max-w-5xl font-display text-3xl font-extrabold uppercase leading-tight text-neutral-900 md:text-5xl">
            Quote, proof, produce, reorder
          </h2>
          <p class="mt-3 max-w-3xl text-base leading-relaxed text-neutral-600 md:mt-4 md:text-lg">
            Apex brings custom packaging pricing, dielines, materials, production timing, and shipping clarity into one clear workflow.
          </p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <a href="#quote" class="btn-primary !bg-[#c99700] !text-neutral-950 hover:!bg-warning">Start a quote</a>
        </div>
      </div>

      <div class="relative mt-8 md:mt-12">
        <div class="absolute left-0 right-0 top-[46px] hidden h-px bg-neutral-300 lg:block"></div>
        <div class="-mx-4 flex snap-x gap-4 overflow-x-auto px-4 pb-3 [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-6 [&::-webkit-scrollbar]:hidden">
          {benefitStrip.map((item, index) => (
            <article class="apex-benefit-card group relative flex h-full min-h-[320px] w-[82vw] max-w-[22rem] shrink-0 snap-start flex-col rounded-md border border-neutral-200 bg-white p-5 shadow-card transition duration-300 hover:-translate-y-2 hover:border-[#7fb4bb] hover:shadow-popover sm:w-auto sm:max-w-none lg:min-h-[390px]">
              <div class="mb-5 flex items-center justify-between gap-3">
                <span class="grid h-16 w-16 place-items-center rounded-lg border border-[#c8dbdd] bg-[#eef6f6] text-[#1f6672] shadow-sm transition duration-300 group-hover:-translate-y-1 group-hover:border-[#7fb4bb] group-hover:bg-[#e0eff1]">
                  <PackagingIcon name={item.icon} class="h-9 w-9" />
                </span>
                <span class="rounded-md bg-[#eef6f6] px-2.5 py-1 text-xs font-black uppercase tracking-wide text-[#1f6672] transition duration-300 group-hover:bg-[#1f6672] group-hover:text-white">0{index + 1}</span>
              </div>
              <p class="text-xs font-black uppercase tracking-[0.16em] text-neutral-500">{item.step}</p>
              <h3 class="mt-2 font-display text-lg font-extrabold uppercase leading-tight text-neutral-900 lg:min-h-[4.75rem]">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600 lg:min-h-[8.25rem]">{item.body}</p>
              <div class="mt-auto border-t border-neutral-200 pt-4 text-sm font-black uppercase tracking-wide text-success">{item.stat}</div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#fffdf8] py-12 md:py-24">
    <div class="container max-w-wide">
      <div class="mb-8 text-center md:mb-12">
        <h2 class="font-display text-3xl font-extrabold uppercase text-neutral-900 md:text-5xl">Premium Finishes</h2>
        <p class="mt-3 text-base text-neutral-600">Finishing options that give custom boxes a premium retail feel. <a href="/packaging-finishes" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">Explore custom packaging finishes</a>.</p>
      </div>
      <div class="-mx-4 flex snap-x gap-4 overflow-x-auto px-4 pb-3 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:px-0 md:pb-0 [&::-webkit-scrollbar]:hidden">
        {finishes.map((finish) => (
          <a href="/packaging-finishes" class="group relative block w-[82vw] max-w-[24rem] shrink-0 snap-start overflow-hidden rounded-md bg-neutral-900 md:w-auto md:max-w-none">
            <img
              src={`/images/home/finishes/${finish.image}.webp`}
              srcset={responsiveImageSrcset(`/images/home/finishes/${finish.image}.webp`, [480, 640, 768])}
              sizes="(max-width: 767px) 82vw, (max-width: 1023px) 50vw, 33vw"
              alt={`${finish.title} packaging finish`}
              width="768"
              height="341"
              loading="lazy"
              decoding="async"
              class="aspect-[16/9] w-full object-cover opacity-85 transition duration-200 group-hover:scale-[1.03] group-hover:opacity-100"
            />
            <h3 class="absolute bottom-4 left-4 font-display text-xl font-extrabold text-neutral-50">{finish.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section
    class="relative overflow-hidden bg-[#061a2e] bg-cover bg-center bg-no-repeat py-12 md:bg-fixed md:py-24"
    style="background-image: url('/images/home/why-choose-parallax-bg.webp');"
  >
    <div class="absolute inset-0 bg-[#041526]/80"></div>
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(4,21,38,0.94)_0%,rgba(4,21,38,0.82)_48%,rgba(4,21,38,0.62)_100%)]"></div>
    <div class="container max-w-wide relative">
      <div class="max-w-4xl">
        <p class="eyebrow">Why Apex</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold text-neutral-50 md:text-6xl">Why Choose Us?</h2>
        <p class="mt-3 max-w-2xl text-base font-semibold uppercase tracking-wide text-neutral-200 md:mt-4 md:text-lg">
          Custom packaging support from brief to reorder.
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 md:mt-12 md:gap-5 lg:grid-cols-4">
        {reasons.map((reason) => (
          <div class="rounded-md border border-white/15 bg-neutral-950/58 p-4 shadow-popover backdrop-blur-sm md:min-h-[260px] md:p-5">
            <span class="mb-4 grid h-14 w-14 place-items-center rounded-lg border border-white/15 bg-white/10 text-[#8fd0cf] shadow-card md:mb-5 md:h-[72px] md:w-[72px]">
              <PackagingIcon name={reason.icon} class="h-10 w-10" />
            </span>
            <h3 class="font-display text-lg font-extrabold text-neutral-50 md:text-xl">{reason.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-200 md:mt-3 md:text-base">{reason.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#fffdf8] py-12 md:py-24">
    <div class="container max-w-wide grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <p class="eyebrow">Specification-led support</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold uppercase text-neutral-900 md:text-5xl">A clearer path from concept to production</h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-neutral-600 md:text-lg">Apex coordinates structure, material, printing, artwork, samples, production, freight, and reorder specifications around the actual product and delivery plan.</p>
      </div>
      <div class="grid grid-cols-2 gap-3 md:gap-4 lg:col-span-7">
        {[
          { src: 'corrugated-boxes-branded', alt: 'Branded corrugated shipping boxes in several sizes' },
          { src: 'polybags-branded', alt: 'Custom printed polybags for apparel and soft goods' },
          { src: 'categories/cosmetic-boxes', alt: 'Custom cosmetic cartons with coordinated brand artwork' },
          { src: 'hero-branded-packaging', alt: 'Assorted custom printed product boxes and mailers' }
        ].map((image) => (
          <img
            src={`/images/home/${image.src}.webp`}
            srcset={responsiveImageSrcset(`/images/home/${image.src}.webp`, [320, 640, 960])}
            sizes="(max-width: 767px) 50vw, 25vw"
            alt={image.alt}
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
            class="aspect-square w-full rounded-md object-cover shadow-card md:rounded-full"
          />
        ))}
      </div>
    </div>
  </section>

  <TrustedClients clients={approvedClientLogos} />

  <section id="quote" class="scroll-mt-28 bg-[#f6f1e7] py-12 md:scroll-mt-32 md:py-24">
    <div class="container max-w-wide">
      <div class="mb-8 max-w-4xl md:mb-10">
        <p class="eyebrow">RFQ desk</p>
        <div class="mt-3 flex flex-wrap items-end gap-x-6 gap-y-3">
          <h2 class="font-display text-3xl font-extrabold uppercase leading-none text-neutral-900 md:text-5xl">Get Custom Quote</h2>
          <span class="mb-1 rounded-md bg-white px-4 py-2 text-sm font-black uppercase tracking-wide text-success shadow-card">Quote-specific delivery review</span>
        </div>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-neutral-600 md:mt-4 md:text-lg">
          Send the package size, material, quantity, and launch timing. Apex reviews the spec and responds with a practical production path.
        </p>
      </div>

      <div class="grid min-w-0 gap-8 xl:grid-cols-12 xl:items-center xl:gap-10">
        <div class="min-w-0 xl:col-span-7">
          <RFQForm source="Home Quote Form" compact={true} />
        </div>

        <aside class="min-w-0 xl:col-span-5">
          <div class="max-w-2xl">
            <h3 class="font-display text-3xl font-extrabold leading-tight text-neutral-900 md:text-4xl">
              Custom Boxes, Designed for Your Brand, Made for Your Needs - Without the Hassle.
            </h3>
            <p class="mt-5 text-base font-semibold leading-relaxed text-neutral-600">
              Ensuring the perfect fit, protection, branding, and presentation for your custom boxes is effortless with Apex's comprehensive support.
            </p>
            <p class="mt-4 text-base font-semibold leading-relaxed text-neutral-600">
              Get expert guidance, access proven box styles, and find the right size by sending your product details. Apex helps select materials, printing techniques, finishes, laminations, and add-ons tailored to your packaging needs and purpose.
            </p>
            <h4 class="mt-7 font-display text-xl font-extrabold text-neutral-900">Still, There's More!</h4>
            <p class="mt-3 text-base font-semibold leading-relaxed text-neutral-600">
              Upload your logo or artwork, and our packaging designers can refine it to match your brand identity while keeping the structure practical for production.
            </p>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {[
                'New look for your brand',
                'Perfect fit to your products',
                'Perfect fit to your purpose',
                'All with convenience quick'
              ].map((item) => (
                <div class="flex min-h-16 items-center gap-3 rounded-md border border-[#ead58d] bg-[#fff8df] px-4 font-display text-sm font-extrabold text-neutral-800">
                  <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[#c99700] text-neutral-950" aria-hidden="true">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m6 12 4 4 8-8"></path>
                    </svg>
                  </span>
                  {item}
                </div>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-[#fffdf8] py-12 md:py-24">
    <div class="container max-w-wide">
      <h2 class="font-display text-2xl font-extrabold text-neutral-900 md:text-4xl">Custom Boxes with Logo for Product and Retail Programs</h2>
      <p class="mt-4 max-w-5xl text-base leading-relaxed text-neutral-600 md:mt-5 md:text-lg">
        Apex Packaging Solutions is a Canada-based custom packaging company providing custom boxes, rigid packaging, corrugated mailers, flexible pouches, paper bags and retail packaging for businesses across Canada, the United States and international markets. Through qualified overseas production facilities, Apex manages each project from structural design, artwork and sampling through production and delivery. See <a href="/custom-boxes-with-logo" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">custom boxes with logo</a> or plan <a href="/wholesale-custom-boxes" class="font-semibold text-neutral-900 underline decoration-accent decoration-2 underline-offset-4">wholesale custom boxes</a> around your project specification.
      </p>
    </div>
  </section>

  <section class="bg-[#061a2e] py-10 text-neutral-50">
    <div class="container max-w-wide -mx-4 flex snap-x gap-4 overflow-x-auto px-4 [scrollbar-width:none] md:mx-auto md:grid md:grid-cols-5 md:overflow-visible md:px-10 [&::-webkit-scrollbar]:hidden">
      {categories.slice(-5).map((cat) => (
        <a href={cat.href} class="w-[48vw] max-w-[13rem] shrink-0 snap-start text-center md:w-auto md:max-w-none">
          <img
            src={cat.image}
            srcset={responsiveImageSrcset(cat.image, [320, 500, 620])}
            sizes="(max-width: 767px) 48vw, 13rem"
            alt={cat.alt}
            width="418"
            height="418"
            loading="lazy"
            decoding="async"
            class="aspect-square w-full rounded-md object-cover md:rounded-none"
          />
          <span class="mt-3 block font-display text-sm font-bold md:text-lg">{cat.title}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

