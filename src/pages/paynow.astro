---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import CTABand from '../components/sections/CTABand.astro';
---
<BaseLayout
  title="Private Payment Links Only | Apex Packaging Solutions"
  description="Apex Packaging Solutions issues secure payment links privately after a quote or invoice has been approved."
  noindex
>
  <PageHeader
    eyebrow="Private payments"
    heading="Secure payment links are issued privately."
    lead="Apex does not publish a general public payment page. Once your quote or invoice is approved, the team will send a fixed-amount secure Stripe checkout link directly to you by email."
  />

  <CTABand
    heading="Need a payment link?"
    lead="Contact Apex with your approved quote or invoice number and the team will send the secure checkout link directly to the customer email on file."
    primaryCta={{ label: 'Contact Apex', href: '/contact' }}
    secondaryCta={{ label: 'Call sales', href: 'tel:+19055951634' }}
  />
</BaseLayout>
