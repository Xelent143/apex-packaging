---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import RelatedContent from '../components/sections/RelatedContent.astro';
import CTABand from '../components/sections/CTABand.astro';
import { buildBreadcrumbSchema, buildFAQSchema, buildServiceSchema } from '../lib/schema';

const finishes = [
  { title: 'Custom embossed boxes Canada', body: 'Embossing and debossing create raised or recessed detail in selected parts of the package. Suitability depends on the board, artwork, structure and production method.' },
  { title: 'Custom gold foil packaging boxes Canada', body: 'Gold foil and other metallic foil treatments can add contrast to logos, type and selected graphic elements. Coverage and registration are confirmed for the chosen structure.' },
  { title: 'Holographic Foiling', href: '/packaging-finishes/holographic-foiling', body: 'Holographic foil can be considered for premium retail projects where the board, artwork and finish direction support the treatment.' },
  { title: 'Custom matte laminated boxes Canada', body: 'Matte lamination can create a low-gloss presentation and protect printed surfaces. The appropriate material and finish are reviewed with the box specification.' },
  { title: 'Custom soft touch laminated packaging Canada', body: 'Soft-touch laminations are a tactile finish option for selected packaging programs. The quotation confirms the available production path, cost and timing.' },
  { title: 'Custom spot UV box packaging Canada', body: 'Spot UV adds gloss to selected artwork areas over a contrasting surface. It should be planned with the final dieline and print file.' }
];
const faqs = [
  {
    "q": "Which packaging finish should I choose for retail, gifting or ecommerce boxes?",
    "a": "Start with the box structure, board, artwork and handling route. Decide whether your priority is surface protection, a low-glare appearance, tactile detail or a reflective accent. Share reference packs, budget and quantity with Apex so the options can be reviewed together. Compare physical samples under realistic lighting and handling conditions rather than choosing a finish from a screen alone."
  },
  {
    "q": "What is the difference between matte, gloss and soft-touch lamination?",
    "a": "Gloss creates a shiny surface, matte gives a lower-sheen appearance, and soft-touch adds a velvety feel. They can change how printed colours appear and how the box feels in the hand. Ask which treatments suit the proposed stock, then compare production-representative samples. Confirm the exact material and performance requirement rather than assuming every finish with the same name behaves identically."
  },
  {
    "q": "How is spot UV different from foil stamping?",
    "a": "Spot UV applies a selective gloss effect, often to contrast with a low-sheen background. Foil stamping transfers a foil effect onto chosen artwork areas, such as a logo or border. The choice depends on whether you want gloss contrast or a metallic or other foil appearance. Review the design, surface compatibility and sample with Apex before specifying either treatment."
  },
  {
    "q": "Can I request gold, silver or holographic foil on custom packaging?",
    "a": "Share a foil reference and mark the areas to be treated. Apex can review available colours and effects against the selected board and production route. Holographic and metallic effects change with light and viewing angle, so a photograph or digital proof is insufficient for final appearance approval. Confirm a physical reference, coverage, detail limits and quoted availability before production."
  },
  {
    "q": "What is the difference between embossing and debossing, and will my logo work?",
    "a": "Embossing raises selected detail; debossing presses it into the surface. Suitability depends on the artwork, board, structure and tooling. Fine lettering, closely spaced elements and areas near folds need technical review. Send vector artwork and request advice on achievable detail. Approve the effect on an appropriate sample rather than assuming the same logo will reproduce equally on every box material."
  },
  {
    "q": "Can I combine soft touch, foil, embossing and spot UV on one box?",
    "a": "Combinations may be possible, but the finishes must be reviewed as one specification. Surface treatments can affect how subsequent foil, coatings or glue bond, and additional operations introduce alignment considerations. Identify the main visual feature and mark the required effects on the dieline. Ask Apex to confirm compatibility, tooling and a suitable combined sample before approving the full order."
  },
  {
    "q": "How should I prepare artwork for foil, embossing or spot UV?",
    "a": "Use the final approved dieline and identify each finish separately with clearly named vector layers or masks, following the production team's file instructions. Keep finish artwork aligned with the print and distinguish it from cut, crease and glue guides. Confirm minimum detail, spacing, registration allowances and areas to avoid. Do not rely on a flattened preview to communicate manufacturing instructions."
  },
  {
    "q": "Will lamination or premium finishes stop scratches, fingerprints or moisture damage?",
    "a": "A finish may improve surface protection, but it does not make every carton scratch-proof or waterproof. Performance depends on the treatment, printed colour, board and exposure. Ask for samples and agree relevant checks for rubbing, folding, stacking and expected handling. Review edges and folds as well as flat panels; choose structural or shipping protection separately when the route requires it."
  },
  {
    "q": "How much do premium packaging finishes cost, and do they affect minimum orders or lead times?",
    "a": "Coverage, number of effects, tooling, material, artwork versions and quantity influence cost and timing. Request a like-for-like quote with optional finish alternatives and ask which setup or tooling costs recur on reorders. Minimum quantities and sample requirements depend on the production route. Give the Canadian postal code or US ZIP code and in-hand date so Apex can confirm freight and the complete project schedule."
  },
  {
    "q": "Can I approve a finish sample before placing a bulk order?",
    "a": "Ask which stock samples, printed proofs or pre-production samples are available, including cost, timing and what each represents. A screen proof can check placement and copy but cannot demonstrate texture, reflectivity or handling performance. Review the proposed board, colour and finish together, including an assembled box where folds or closures matter. Retain an agreed reference and artwork revision for production and repeat orders."
  },
  {
    "q": "Can foil, gloss or embossing affect barcode, QR-code or label readability?",
    "a": "Reflective surfaces, low contrast and physical distortion can interfere with scanning or reading. Reserve a suitable area for codes and essential text, with the required clear space, and keep disruptive effects away from it. Check code size and placement on the final packaging. Verify printed codes after finishing and assembly rather than relying solely on a digital artwork scan."
  },
  {
    "q": "Are foil-stamped, laminated or spot-UV boxes recyclable in Canada and the USA?",
    "a": "Assess the complete pack, including board, film, coatings, foil coverage, adhesives and inserts. A finish name alone does not establish recyclability or compostability. Request available documentation for the actual specification and check collection and processing acceptance in the receiving community. Recycled content is a separate claim. Use qualified disposal instructions supported by the finished materials and local access, rather than a blanket environmental promise."
  }
];
const breadcrumb = buildBreadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Packaging Finishes', url: '/packaging-finishes' }]);
const service = buildServiceSchema({ name: 'Custom packaging finishes', description: 'Custom embossed, foil-stamped, matte, soft-touch and spot-UV packaging finishes for product-specific packaging projects.', url: '/packaging-finishes' });
---
<BaseLayout
  title="Custom Packaging Finishes Canada | Foil, Embossing & Spot UV"
  description="Compare embossing, foil, lamination, soft-touch and spot-UV options for custom packaging. Finishes are quoted to the approved box specification."
  image="/images/home/finishes/gold-foiling.webp"
  schemaBlocks={[breadcrumb, service, buildFAQSchema(faqs)]}
>
  <PageHeader
    eyebrow="Packaging finishes · Custom print"
    heading="Custom packaging finishes in Canada for branded boxes and retail presentation."
    lead="Compare embossing, foil, matte lamination, soft touch and spot UV for Canada-bound packaging projects before requesting a project-specific box quotation. The right finish depends on the structure, material, artwork and intended use."
    imageSrc="/images/home/finishes/gold-foiling.webp"
    imageAlt="Gold foil and premium finishing details on custom packaging boxes."
  />

  <section class="bg-neutral-50 py-12 md:py-24">
    <div class="container max-w-wide grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {finishes.map((finish) => <article class="rounded-md border border-neutral-200 bg-white p-5 shadow-card"><h2 class="font-display text-xl font-extrabold text-neutral-900">{finish.href ? <a href={finish.href} class="underline decoration-accent underline-offset-4">{finish.title}</a> : finish.title}</h2><p class="mt-3 leading-relaxed text-neutral-600">{finish.body}</p></article>)}
    </div>
  </section>

  <section class="border-y border-neutral-200 bg-white py-12 md:py-24">
    <div class="container max-w-default prose-apex">
      <h2>Prepare the finish direction before artwork approval</h2>
      <p>Share the product, packaging structure, artwork, target quantity, delivery destination and any reference packaging. These inputs help confirm whether the requested finish works with the selected board and print process before a proof or sample is approved. Use the <a href="/blog/printed-packaging-boxes-and-brand-colour-control-2026-08-26">packaging colour-control guide</a> to define references, proof limitations and acceptance criteria before production.</p>
      <ul><li>Mark the artwork areas that need foil, embossing, spot UV or another finish.</li><li>Send brand-colour references and a vector logo where available.</li><li>State whether the box is for ecommerce, shelf retail, gifting or another channel.</li><li>Include quantity and required in-hand date so the quotation can confirm the production path.</li></ul>
    </div>
  </section>

  <FAQAccordion faqs={faqs} />
  <RelatedContent items={[
    { title: 'Custom Boxes With Logo', href: '/custom-boxes-with-logo', description: 'Plan structure, logo placement, print and finish around the complete box specification.' },
    { title: 'Custom Rigid Boxes', href: '/industries/rigid-boxes', description: 'Review premium box structures, inserts and presentation options.' },
    { title: 'Packaging Artwork Requirements', href: '/blog/packaging-artwork-requirements-bleed-dielines-barcodes-ink-limits', description: 'Prepare the dieline and production artwork for a finish review.' }
  ]} />
  <CTABand heading="Request a finish-specific box quotation." lead="Send the product, structure, artwork, finish direction, quantity and destination for a project-specific proposal." primaryCta={{ label: 'Request a quote', href: '/contact' }} />
</BaseLayout>
