---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackagingIcon from '../components/ui/PackagingIcon.astro';
import QuoteFormFeedback from '../components/forms/QuoteFormFeedback.astro';
import { siteConfig } from '../site.config';
import { buildBreadcrumbSchema } from '../lib/schema';

const breadcrumb = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Request a Quote', url: '/contact' }
]);

const mapQuery = `${siteConfig.streetAddress}, ${siteConfig.addressLocality}, ${siteConfig.addressRegion} ${siteConfig.postalCode}, ${siteConfig.addressCountry}`;
const mapsSearchUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
const mapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=15&output=embed`;
---
<BaseLayout
  title="Custom Packaging Quote | Apex Packaging"
  description="Request a custom packaging quote with box type, dimensions, material, printing, finishes, quantity, artwork, and delivery details for Canada or the United States."
  schemaBlocks={[breadcrumb]}
>
  <section class="bg-neutral-50 py-10 md:py-16">
    <div class="container max-w-wide">
      <div class="mx-auto max-w-[64rem] overflow-hidden rounded-[1.5rem] border border-[#d8cba7] bg-[#e9e2d7] shadow-popover md:rounded-[2rem]">
        <div class="bg-accent px-6 py-5 text-center md:px-8 md:py-6">
          <h1 class="font-display text-2xl font-extrabold uppercase tracking-wide text-neutral-950 md:text-4xl">
            Get Custom Quote
          </h1>
        </div>

        <div class="border-b border-[#d8cba7] bg-white px-5 py-4 text-sm leading-relaxed text-neutral-700 md:px-8">
          <p>You may enquire before final dimensions, material, quantity, or artwork are known. Required to submit: your name, email address, a short project brief, and the human-confirmation checkbox. All other fields are optional.</p>
        </div>

        <form
          class="grid gap-5 p-5 md:gap-6 md:p-8"
          action="/api/quote"
          method="POST"
          enctype="multipart/form-data"
          data-quote-form
        >
          <input type="hidden" name="source" value="Request Quote Contact Form" />
          <input type="hidden" name="redirectTo" value="/thank-you" />
          <input type="hidden" name="company" value="Not provided" />
          <label class="hidden" aria-hidden="true">
            Website
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>

          <fieldset class="grid gap-3">
            <legend class="mb-1 flex items-center gap-3 font-display text-xl font-extrabold text-neutral-900">
              <span class="grid h-10 w-10 place-items-center rounded-md bg-accent text-neutral-950" aria-hidden="true">
                <PackagingIcon name="quote-review" class="h-5 w-5" />
              </span>
              Product Information
            </legend>
            <input
              class="h-14 border border-transparent bg-white px-5 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent"
              name="product"
              placeholder="Product Name (Optional)"
              aria-label="Product name (optional)"
            />
          </fieldset>

          <fieldset class="grid gap-3">
            <legend class="mb-1 flex items-center gap-3 font-display text-xl font-extrabold text-neutral-900">
              <span class="grid h-10 w-10 place-items-center rounded-md bg-accent text-neutral-950" aria-hidden="true">
                <PackagingIcon name="custom-spec" class="h-5 w-5" />
              </span>
              Select Sizes
            </legend>
            <div class="grid gap-3 md:grid-cols-[1fr_1fr_1fr_8rem]">
              <input class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="length" placeholder="Length (Optional)" aria-label="Package length (optional)" />
              <input class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="width" placeholder="Width (Optional)" aria-label="Package width (optional)" />
              <input class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="depth" placeholder="Depth (Optional)" aria-label="Package depth (optional)" />
              <select class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-800 focus:border-accent" name="unit" aria-label="Measurement unit (optional)">
                <option value="">Unit (Optional)</option>
                <option>inch</option>
                <option>cm</option>
                <option>mm</option>
              </select>
            </div>
          </fieldset>

          <fieldset class="grid gap-3">
            <legend class="mb-1 flex items-center gap-3 font-display text-xl font-extrabold text-neutral-900">
              <span class="grid h-10 w-10 place-items-center rounded-md bg-accent text-neutral-950" aria-hidden="true">
                <PackagingIcon name="sample-run" class="h-5 w-5" />
              </span>
              Choose Materials
            </legend>
            <div class="grid gap-3 md:grid-cols-[1fr_1fr_0.9fr]">
              <select class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-800 focus:border-accent" name="material" aria-label="Packaging material (optional)">
                <option value="">Material (Optional)</option>
                <option>Cardboard Boxes</option>
                <option>Kraft Boxes</option>
                <option>Rigid Boxes</option>
                <option>Corrugated Boxes</option>
                <option>Mylar Bags</option>
                <option>Gable Boxes</option>
              </select>
              <select class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-800 focus:border-accent" name="printing" aria-label="Printing option (optional)">
                <option value="">Printing (Optional)</option>
                <option>Full-color exterior</option>
                <option>Inside and outside print</option>
                <option>Black ink only</option>
                <option>No print</option>
              </select>
              <input class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="quantity" placeholder="Quantity (Optional)" aria-label="Quantity (optional)" />
            </div>
          </fieldset>

          <fieldset class="grid gap-3">
            <legend class="mb-1 flex items-center gap-3 font-display text-xl font-extrabold text-neutral-900">
              <span class="grid h-10 w-10 place-items-center rounded-md bg-accent text-neutral-950" aria-hidden="true">
                <PackagingIcon name="design-proof" class="h-5 w-5" />
              </span>
              Upload Artwork
            </legend>
            <label class="flex min-h-14 cursor-pointer items-center bg-white px-4 text-base font-semibold text-neutral-500 transition hover:ring-1 hover:ring-accent">
              <span class="sr-only">Upload artwork file</span>
              <input
                class="text-base"
                name="artwork"
                type="file"
                accept=".pdf,.ai,.eps,.png,.jpg,.jpeg,.webp,application/pdf,application/postscript,image/png,image/jpeg,image/webp"
                aria-label="Upload artwork file"
                aria-describedby="contact-artwork-help contact-artwork-warning"
                data-artwork-input
                data-max-bytes="8388608"
                data-supported-extensions=".pdf,.ai,.eps,.png,.jpg,.jpeg,.webp"
                data-supported-mime-types=",application/octet-stream,application/pdf,application/postscript,application/illustrator,application/vnd.adobe.illustrator,application/x-illustrator,image/x-eps,image/png,image/jpeg,image/pjpeg,image/webp"
                data-artwork-email={siteConfig.email}
              />
            </label>
            <p id="contact-artwork-help" class="text-sm font-medium text-neutral-600">PDF, AI, EPS, PNG, JPG, JPEG or WEBP. Maximum 8 MB.</p>
            <p id="contact-artwork-warning" class="hidden text-sm font-bold text-[#7a271a]" role="status" aria-live="polite" data-artwork-warning></p>
          </fieldset>

          <fieldset class="grid gap-3">
            <legend class="mb-1 flex items-center gap-3 font-display text-xl font-extrabold text-neutral-900">
              <span class="grid h-10 w-10 place-items-center rounded-md bg-accent text-neutral-950" aria-hidden="true">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z"></path>
                </svg>
              </span>
              Required Contact Information
            </legend>
            <div class="grid gap-3 md:grid-cols-3">
              <input required class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="name" placeholder="Full Name*" autocomplete="name" aria-label="Full name" />
              <input required type="email" class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="email" placeholder="Email ID*" autocomplete="email" aria-label="Email address" />
              <input type="tel" class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="phone" placeholder="Contact Number (Optional)" autocomplete="tel" aria-label="Contact number (optional)" />
            </div>
            <input class="h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent" name="country" placeholder="Country (Optional)" autocomplete="country-name" aria-label="Country" />
          </fieldset>

          <fieldset class="grid gap-3">
            <legend class="mb-1 flex items-center gap-3 font-display text-xl font-extrabold text-neutral-900">
              <span class="grid h-10 w-10 place-items-center rounded-md bg-accent text-neutral-950" aria-hidden="true">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M11 7h2v2h-2Zm0 4h2v6h-2Zm1-9a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2Z"></path>
                </svg>
              </span>
              Required Project Brief
            </legend>
            <textarea
              required
              class="min-h-[10rem] border border-transparent bg-white px-4 py-4 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent"
              name="details"
              placeholder="Message..."
              aria-label="Project details"
            ></textarea>
          </fieldset>

          <label class="flex min-h-14 items-center gap-3 rounded-md border border-[#d8cba7] bg-white px-5 text-base font-bold text-neutral-800">
            <input class="h-5 w-5 accent-[#1f6672]" type="checkbox" name="humanConfirmation" value="confirmed" required />
            <span>I am not a robot</span>
          </label>

          <QuoteFormFeedback />

          <div class="flex justify-end pt-1">
            <button class="min-h-14 rounded-md bg-accent px-10 py-3 text-lg font-black text-neutral-950 transition hover:bg-warning" type="submit">
              Submit
            </button>
          </div>
          <p class="text-sm leading-relaxed text-neutral-600">
            After a successful submission, keep the reference shown on screen. Apex will review the brief and use your email address to confirm missing specifications and the next quotation step. Submission does not create a pricing or delivery commitment.
          </p>
        </form>
      </div>

      <div class="mx-auto mt-7 grid max-w-[68rem] gap-4 text-sm text-neutral-600 md:grid-cols-3">
        <div class="rounded-xl border border-neutral-200 bg-white px-5 py-4 shadow-card">
          <strong class="block font-display text-neutral-900">Direct contact</strong>
          <a class="mt-2 block break-all text-accent hover:underline" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          <a class="mt-2 block text-accent hover:underline" href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white px-5 py-4 shadow-card">
          <strong class="block font-display text-neutral-900">What Apex reviews</strong>
          <span class="mt-2 block">Product fit, dimensions, material, print, quantity, destination, artwork status, and required delivery date.</span>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white px-5 py-4 shadow-card">
          <strong class="block font-display text-neutral-900">Business address</strong>
          <a class="mt-2 block text-accent hover:underline" href={mapsSearchUrl} target="_blank" rel="noopener noreferrer">
            {siteConfig.formattedAddress}
          </a>
        </div>
      </div>

      <section id="location" class="mx-auto mt-8 max-w-[68rem] overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-card">
        <div class="flex flex-col justify-between gap-4 border-b border-neutral-200 px-5 py-5 md:flex-row md:items-center md:px-7">
          <div>
            <p class="eyebrow">Visit Apex</p>
            <h2 class="mt-2 font-display text-2xl font-extrabold text-neutral-900">Our London, Ontario location</h2>
            <p class="mt-2 text-sm text-neutral-600 md:text-base">{siteConfig.formattedAddress}</p>
          </div>
          <a class="btn-primary shrink-0" href={mapsSearchUrl} target="_blank" rel="noopener noreferrer">
            Open in Google Maps
          </a>
        </div>
        <iframe
          title="Map to Apex Packaging Solutions in London, Ontario"
          src={mapsEmbedUrl}
          class="h-[22rem] w-full border-0 md:h-[28rem]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </section>
    </div>
  </section>
</BaseLayout>
