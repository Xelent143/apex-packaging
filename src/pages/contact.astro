---
import BaseLayout from '../layouts/BaseLayout.astro';
import RFQForm from '../components/forms/RFQForm.astro';
import TrustpilotTrustBox from '../components/trust/TrustpilotTrustBox.astro';
import { siteConfig } from '../site.config';
import { buildBreadcrumbSchema } from '../lib/schema';

const breadcrumb = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Request a Quote', url: '/contact' }
]);
---
<BaseLayout
  title="Custom Packaging Quote | Apex Packaging"
  description="Request a custom packaging quote with box type, dimensions, material, printing, finishes, quantity, artwork, and delivery details for Canada or the United States."
  schemaBlocks={[breadcrumb]}
>
  <section class="bg-neutral-50 py-10 md:py-16">
    <div class="container max-w-wide">
      <div class="mx-auto mb-8 max-w-3xl text-center md:mb-12">
        <p class="eyebrow">Packaging RFQ</p>
        <h1 class="mt-3 font-display text-3xl font-extrabold uppercase leading-tight text-neutral-900 md:text-5xl">Request a custom packaging quote</h1>
        <p class="mt-4 text-base leading-relaxed text-neutral-600 md:text-lg">Share the core specification in three short steps. Apex reviews product fit, material, print, production, freight, and delivery requirements before responding.</p>
      </div>

      <div class="mx-auto max-w-[68rem]">
        <RFQForm source="Request Quote Contact Form" />
        <TrustpilotTrustBox class="mt-6 rounded-xl border border-neutral-200 bg-white p-5 shadow-card" />
      </div>

      <div class="mx-auto mt-7 grid max-w-[68rem] gap-4 text-sm text-neutral-600 md:grid-cols-3">
        <div class="rounded-xl border border-neutral-200 bg-white px-5 py-4 shadow-card">
          <strong class="block font-display text-neutral-900">Direct contact</strong>
          <a class="mt-2 block break-all text-accent hover:underline" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          <a class="mt-2 block text-accent hover:underline" href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white px-5 py-4 shadow-card">
          <strong class="block font-display text-neutral-900">What Apex reviews</strong>
          <span class="mt-2 block">Product fit, dimensions, material, print, quantity, destination, artwork status, and required delivery date.</span>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white px-5 py-4 shadow-card">
          <strong class="block font-display text-neutral-900">Business address</strong>
          <span class="mt-2 block">{siteConfig.formattedAddress}</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
