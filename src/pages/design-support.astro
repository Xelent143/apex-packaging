---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import RelatedContent from '../components/sections/RelatedContent.astro';
import CTABand from '../components/sections/CTABand.astro';
import { buildBreadcrumbSchema, buildFAQSchema } from '../lib/schema';

const faqs = [
  { q: 'Can I use the dieline file with a different printer?', a: 'File ownership, editable-file delivery, licensing, and reuse rights depend on the agreed design and production scope. Ask Apex to document those terms before design work begins.' },
  { q: 'Can Apex help with artwork as well as the packaging structure?', a: 'Apex can review structural design, dieline, artwork-preparation, proof, and mockup needs. The available scope and any separate design cost are confirmed after the product and artwork brief is reviewed.' },
  { q: 'Which file formats should I provide?', a: 'Send editable vector artwork where available, along with any brand, barcode, image, and colour references. Apex will confirm the production and preview formats required for the selected structure, print method, and facility.' },
  { q: 'Can I enquire before my dimensions or material are final?', a: 'Yes. Send the product information, target use, quantity range, destination, and artwork you have. Apex can identify the missing decisions and confirm the next design or quotation step.' }
];
const breadcrumb = buildBreadcrumbSchema([{name:'Home',url:'/'},{name:'Design Support',url:'/design-support'}]);
---
<BaseLayout
  title="Custom Packaging Design Support Canada | Apex"
  description="Plan structural packaging, dielines, artwork preparation, proofs, mockups and the production specification needed for a custom packaging project."
  schemaBlocks={[breadcrumb, buildFAQSchema(faqs)]}
>
  <PageHeader
    eyebrow="Design Support"
    heading="Send the product details. Build a production-ready packaging specification."
    lead="Many custom-packaging buyers have a logo, product dimensions, and a launch date but no production-ready structure. Apex coordinates the dieline, artwork preparation, proofing, mockups, and sample path needed for qualified production facilities."
  />

  <section class="py-16 md:py-24">
    <div class="container max-w-default prose-apex">
      <h2>Support that can be scoped for the project</h2>
      <ol>
        <li><strong>Structural design</strong> — dieline requirements can be reviewed against the product dimensions and selected box style.</li>
        <li><strong>Print preparation</strong> — colour space, bleed, trim, imagery, barcode, and file requirements can be reviewed for the selected production method.</li>
        <li><strong>Proof or mockup</strong> — the appropriate approval format is confirmed with the design scope.</li>
        <li><strong>Physical pre-production sample</strong> — availability, specification, cost, and timing are confirmed for the individual project.</li>
      </ol>

      <h2>Turnaround</h2>
      <ul>
        <li><strong>First dieline and 3D mockup</strong>: timing depends on structural complexity and the completeness of the product and artwork brief.</li>
        <li><strong>Revisions</strong>: timing depends on the requested structural or artwork changes.</li>
        <li><strong>Physical sample</strong>: timing depends on the structure, material, print method, finish, and delivery destination.</li>
      </ul>

      <h2>What we need from you</h2>
      <ul>
        <li>Logo as a vector file (AI, EPS, or PDF) where available. If only a raster file exists, send the highest-resolution version so Apex can confirm whether conversion or redrawing is required.</li>
        <li>Brand colours as Pantone codes or hex values.</li>
        <li>Product dimensions (length × width × height) and weight.</li>
        <li>Quantity, target lead time, and any sustainability requirements.</li>
        <li>Reference images — competitor packaging you like or dislike is useful.</li>
      </ul>
      <p>Before releasing files, review the <a href="/blog/packaging-design-services-before-production-2026-08-29">packaging production-approval guide</a> for structure, artwork, proof, and revision-control decisions. If colour consistency matters, the <a href="/blog/printed-packaging-boxes-and-brand-colour-control-2026-08-26">packaging colour-control guide</a> explains how references, substrates, proof limitations, acceptance criteria, and reorder records work together.</p>

      <h2>How scope and cost are confirmed</h2>
      <p>Design and approval requirements depend on the existing files, structural complexity, number of SKUs, revision needs, proof or sample path, production method, and whether the work forms part of a packaging order. Apex confirms the included work, separate charges, file rights, and approval stages in the project-specific quotation before work begins.</p>
      <p>You may make an initial enquiry without final dimensions, material, or production-ready artwork. Send the information and assets you have; Apex will identify what is still needed for a design scope or packaging quotation.</p>
    </div>
  </section>

  <FAQAccordion faqs={faqs} />

  <RelatedContent items={[
    { title: 'Packaging Dieline Guide', href: '/blog/packaging-dieline-guide', description: 'Review cut lines, creases, bleed, safe zones, glue areas, file setup, and prepress checks.' },
    { title: 'Packaging Artwork Requirements', href: '/blog/packaging-artwork-requirements-bleed-dielines-barcodes-ink-limits', description: 'Prepare barcodes, colours, imagery, and controlled artwork revisions.' },
    { title: 'Packaging Material Comparison', href: '/blog/packaging-material-comparison-guide', description: 'Choose a material family before structural design and sampling.' }
  ]} />

  <CTABand
    heading="Start with the product and artwork information you have."
    lead="Final dimensions and material are not required for the first enquiry. Apex will review the brief and confirm the missing inputs, available design or sample path, scope, cost, and next approval step."
    primaryCta={{ label: 'Request a design review', href: '/contact' }}
  />
</BaseLayout>
