---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import ServiceMatrix from '../components/sections/ServiceMatrix.astro';
import RelatedContent from '../components/sections/RelatedContent.astro';
import CTABand from '../components/sections/CTABand.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const services = [
  { title: 'Corrugated Boxes', href: '/services/corrugated-boxes', meta: 'RSC · FOL · die-cut', description: 'Single-wall, double-wall, RSC, FOL, die-cut, display, and mailer formats quoted to the product and shipping route.' },
  { title: 'Mailer & Rigid Boxes', href: '/services/mailer-boxes', meta: 'D2C · rigid · magnetic', description: 'Printed corrugated mailers, rigid presentation boxes, magnetic closures, drawers, and premium retail structures.' },
  { title: 'Polybags', href: '/services/polybags', meta: 'LDPE · HDPE · specialty structures', description: 'Flat, gusseted, wicket, slider and ZIP bags. Material, gauge and documentation requirements are confirmed by quotation.' },
  { title: 'Industrial & Bulk', href: '/services/industrial-bulk-packaging', meta: 'Gaylord · stretch · shrink', description: 'Bulk corrugated, stretch and shrink film, edge protectors. Pallet-quantity pricing.' },
  { title: 'Protective Packaging', href: '/services/protective-packaging', meta: 'Foam · VCI · void fill', description: 'Custom-cut foam inserts, Instapak®, VCI rust-prevention paper. Specified to ISTA drop-test class.' },
  { title: 'Design Support', href: '/design-support', meta: 'Dieline · 3D · print prep', description: 'Structural design, dielines, artwork preparation, proofing, samples, and production-ready files.' }
];

const breadcrumb = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' }
]);
---
<BaseLayout
  title="Custom Packaging & Custom Boxes Canada | Apex Packaging"
  description="Explore custom packaging and custom boxes: cartons, mailers, rigid boxes, pouches, bags, food packaging, inserts, printing and finishing from Apex Packaging."
  schemaBlocks={[breadcrumb]}
>
  <PageHeader
    eyebrow="Services"
    heading="Custom packaging and custom boxes, managed from brief to delivery."
    lead="Apex supplies folding cartons, retail boxes, corrugated mailers, rigid boxes, flexible pouches, paper bags, food packaging, inserts, printing, and premium finishes. Projects are produced through qualified overseas facilities and managed by Apex for customers in Canada, the United States, and international markets."
  />
  <ServiceMatrix heading="Pick the service that fits the job." services={services} />
  <RelatedContent
    heading="Custom packaging by location"
    items={[
      { title: 'Custom Packaging Toronto', href: '/locations/toronto-custom-packaging', description: 'Boxes, mailers, retail packaging, and inserts for Toronto and GTA delivery.' },
      { title: 'Custom Packaging Chicago', href: '/locations/chicago-custom-packaging', description: 'Commercial packaging for Chicago operations and Midwest distribution.' },
      { title: 'Custom Packaging Finishes', href: '/packaging-finishes', description: 'Compare foil, embossing, matte, soft-touch and spot-UV options before quoting.' }
    ]}
  />
  <section class="border-y border-neutral-200 bg-neutral-50 py-10 md:py-14">
    <div class="container max-w-default">
      <h2 class="font-display text-2xl font-bold text-neutral-900 md:text-3xl">Looking for custom packaging near you?</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-neutral-600">Apex is Canada-based and coordinates product-specific packaging delivery for buyers in Canada, the United States and international markets. Start with the city page closest to your receiving location, then send the product and delivery details for a quotation.</p>
    </div>
  </section>
  <CTABand
    heading="Not sure which service fits your product?"
    lead="Send dimensions and a description. Apex will recommend the right packaging type and quote the spec."
    primaryCta={{ label: 'Send your details', href: '/contact' }}
  />
</BaseLayout>
