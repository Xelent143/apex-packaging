---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import FAQAccordion from '../../components/sections/FAQAccordion.astro';
import RelatedContent from '../../components/sections/RelatedContent.astro';
import CTABand from '../../components/sections/CTABand.astro';
import { buildBreadcrumbSchema, buildServiceSchema, buildFAQSchema } from '../../lib/schema';

const faqs = [
  { q: 'What gauge do I need?', a: 'Light retail/garment: 1.0–2.0 mil. General shipping: 2.0–4.0 mil. Heavy industrial/furniture/mattress: 4.0–6.0 mil. Apex\'s team recommends a gauge based on product weight, edge sharpness, and stacking pattern.' },
  { q: 'Can Apex support food-contact packaging requirements?', a: 'Share the intended use and documentation requirement. Material availability and applicable documentation are confirmed for the specific product and destination.' },
  { q: 'Can polybags include recycled or compostable material options?', a: 'Material and end-of-life options depend on the bag structure, performance requirements, destination and available documentation. Apex confirms applicable options in the quotation.' },
  { q: 'What is the MOQ on custom print?', a: 'Minimum order quantities vary by pouch or bag style, dimensions, material structure, printing method, quantity, and delivery destination. Contact Apex for a product-specific quotation.' }
];
const breadcrumb = buildBreadcrumbSchema([{name:'Home',url:'/'},{name:'Services',url:'/services'},{name:'Polybags',url:'/services/polybags'}]);
const service = buildServiceSchema({ name:'Custom pouches, Mylar bags and polybags', description:'Flexible packaging including custom pouches, Mylar bags, polybags, anti-static, food-contact, and specialty structures managed from specification through delivery.', url:'/services/polybags'});
---
<BaseLayout
  title="Custom Pouches, Mylar Bags & Polybags | Apex Packaging"
  description="Custom pouches, Mylar bags and polybags in flat, gusseted, wicket, slider and specialty structures, coordinated through qualified overseas production facilities."
  schemaBlocks={[breadcrumb, service, buildFAQSchema(faqs)]}
>
  <PageHeader
    eyebrow="Service · Polybags"
    heading="Custom pouches, Mylar bags and polybags for retail, food and industrial programs."
    lead="Apex coordinates flexible packaging through qualified overseas production facilities for customers in Canada, the United States, and international markets. Bag structure, material, print, minimum order, production time, and delivery schedule are quoted for the exact application."
    imageSrc="/images/services/polybags-generated-banner.png"
    imageAlt="Apex Packaging custom polybags banner with clear bags, printed mailers, wicketed runs, VCI protective bags, branded cartons, feature icons, and service headline."
    imageIsFullBanner={true}
  />

  <section class="py-16 md:py-24">
    <div class="container max-w-default prose-apex">
      <h2>Bag types</h2>
      <ul>
        <li><strong>Flat polybags</strong> — the workhorse for general shipping and product packaging.</li>
        <li><strong>Gusseted polybags</strong> — side gussets expand to hold bulkier items.</li>
        <li><strong>Wicket bags</strong> — pre-loaded on a wicket for high-speed bagging lines.</li>
        <li><strong>Coreless bags</strong> — folded on rolls, dispenser-friendly.</li>
        <li><strong>Slider and ZIP bags</strong> — reclosable, for resealable consumer products.</li>
        <li><strong>Pre-opened bags on rolls (POR)</strong> — auto-bagger compatible.</li>
      </ul>

      <h2>Vertical-specific specs</h2>
      <ul>
        <li><strong>Garment bags</strong> — clear or printed, low-density, with vent holes if required.</li>
        <li><strong>Mattress bags</strong> — heavy-gauge (4–6 mil), gusseted, 14"+ depth.</li>
        <li><strong>Furniture bags</strong> — extra-large, reinforced seam, dust-protection grade.</li>
        <li><strong>Produce bags</strong> — vented and wicket-loaded options, subject to the intended-use specification.</li>
        <li><strong>Pound bags</strong> — pre-cut, suitable for produce and bakery weighing.</li>
        <li><strong>PTO bags</strong> — pull-tab opening for retail dispensing.</li>
      </ul>

      <h2>Material and gauge options</h2>
      <table>
        <thead><tr><th>Material</th><th>Use case</th><th>Typical gauges</th></tr></thead>
        <tbody>
          <tr><td>LDPE</td><td>Light shipping, garment, retail</td><td>1.0 – 4.0 mil</td></tr>
          <tr><td>HDPE</td><td>Produce, food, dispensers</td><td>0.5 – 2.0 mil</td></tr>
          <tr><td>LLDPE</td><td>Heavy industrial, mattress, furniture</td><td>3.0 – 6.0 mil</td></tr>
          <tr><td>MDPE</td><td>Strength-with-clarity applications</td><td>1.5 – 4.0 mil</td></tr>
          <tr><td>Specialty blends</td><td>Project-specific material requirements</td><td>Confirmed by quotation</td></tr>
        </tbody>
      </table>

      <h2>Specialty options</h2>
      <ul>
        <li><strong>Anti-static (pink)</strong> polybags for electronics shipping.</li>
        <li><strong>Food-contact</strong> material requirements, subject to application and documentation review.</li>
        <li><strong>Specialty material</strong> options, subject to performance, destination and documentation review.</li>
        <li><strong>VCI bags</strong> for rust-prevention on metal parts.</li>
        <li><strong>Static-shielding</strong> metallized film for sensitive electronics.</li>
      </ul>
    </div>
  </section>

  <FAQAccordion faqs={faqs} />

  <RelatedContent items={[
    { title: 'Polybag thickness guide', href:'/blog/poly-bag-thickness-guide', description:'How to assess gauge requirements for an application.' },
    { title:'Industrial & Bulk', href:'/services/industrial-bulk-packaging', description:'Pallet wrap, shrink film, edge protectors.' },
    { title:'Material options', href:'/sustainability', description:'Product-specific material and documentation requirements.' }
  ]} />

  <CTABand
    heading="Send your spec."
    lead="Send the bag type, dimensions, material or barrier needs, print scope, quantity, destination, and required delivery date for a product-specific quotation."
    primaryCta={{ label: 'Request a polybag quote', href: '/contact' }}
  />
</BaseLayout>
