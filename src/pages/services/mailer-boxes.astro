---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import FAQAccordion from '../../components/sections/FAQAccordion.astro';
import RelatedContent from '../../components/sections/RelatedContent.astro';
import CTABand from '../../components/sections/CTABand.astro';
import { buildBreadcrumbSchema, buildServiceSchema, buildFAQSchema } from '../../lib/schema';

const faqs = [
  { q: 'What is the minimum order on custom-printed mailers?', a: 'Minimum order quantities vary by structure, dimensions, material, printing method, finish, quantity, and delivery destination. Contact Apex for a mailer-specific quotation.' },
  { q: 'What artwork files do you need?', a: 'Vector logos (AI, EPS, or PDF) and brand-colour references help prepare artwork. Artwork preparation requirements and any related costs are confirmed in the quotation.' },
  { q: 'Where are Apex mailer boxes produced?', a: 'Approved projects are produced through qualified overseas facilities. Apex coordinates the dieline, artwork, sampling, production, quality review, freight, and delivery.' },
  { q: 'Can I print on the inside of the box?', a: 'Interior print may be available. The method, coverage, cost and production implications are confirmed for the selected structure.' }
];
const breadcrumb = buildBreadcrumbSchema([{name:'Home',url:'/'},{name:'Services',url:'/services'},{name:'Mailer Boxes',url:'/services/mailer-boxes'}]);
const service = buildServiceSchema({ name:'Custom mailer and rigid boxes', description:'Custom-printed mailers, rigid presentation boxes, magnetic closures, drawer boxes, and premium retail structures managed from design through delivery.', url:'/services/mailer-boxes'});
---
<BaseLayout
  title="Custom Mailer Boxes Wholesale Canada | Apex Packaging"
  description="Custom mailer boxes for wholesale ecommerce, subscription and retail programs, with corrugated structures, print and quote requirements confirmed by project."
  schemaBlocks={[breadcrumb, service, buildFAQSchema(faqs)]}
>
  <PageHeader
    eyebrow="Service · Mailer Boxes"
    heading="Custom mailer boxes for wholesale ecommerce and branded unboxing."
    lead="Apex supplies printed corrugated mailers, rigid presentation boxes, magnetic closures, drawers, and premium retail structures for businesses in Canada, the United States, and international markets. Qualified overseas facilities produce approved projects while Apex manages design, sampling, production, quality coordination, and delivery."
    imageSrc="/images/services/mailer-boxes-generated-banner.webp"
    imageAlt="Apex Packaging custom mailer box banner with headline, feature icons, and branded black, kraft, and white mailer boxes."
    imageIsFullBanner={true}
  />

  <section class="py-16 md:py-24">
    <div class="container max-w-default prose-apex">
      <h2>Structural options</h2>
      <ul>
        <li><strong>Tuck-top mailer</strong> — friction-tab closure, the standard e-commerce mailer.</li>
        <li><strong>Magnetic-close mailer</strong> — premium retail-feel, hidden magnet closure.</li>
        <li><strong>ZIP-tear opening</strong> — perforated pull-strip for unboxing experience.</li>
        <li><strong>Dispenser-style</strong> — open-flap design for repeat-access products.</li>
        <li><strong>Custom dieline</strong> — Apex's design team draws a structural dieline from product dimensions.</li>
      </ul>

      <h2>Print options</h2>
      <ul>
        <li><strong>Exterior full-colour print</strong> with one-pass digital or flexo. Spot colour matching to brand swatch.</li>
        <li><strong>Interior print</strong> — one colour or full-colour. Used for inside-lid messaging or pattern.</li>
        <li><strong>Spot UV, foil stamp, embossing</strong> available on litho-laminated stock.</li>
        <li><strong>Spot coatings</strong> — matte, soft-touch, gloss.</li>
      </ul>

      <h2>Material options</h2>
      <ul>
        <li>E-flute corrugated (standard for mailers) — light, printable, structurally rigid.</li>
        <li>B-flute (heavier feel, more protection).</li>
        <li>Material, recycled-content and certification requirements reviewed for the selected product.</li>
      </ul>

      <h2>Sample process</h2>
      <ol>
        <li>Send brand assets (logo, brand colours, any reference photos).</li>
        <li>Apex prepares the structural dieline and 3D mockup on the schedule confirmed after reviewing the brief.</li>
        <li>Approve digitally, or order a physical pre-production sample.</li>
        <li>On approval, Apex confirms the production and shipping schedule for the selected structure, material, print method, quantity, and destination.</li>
      </ol>
    </div>
  </section>

  <FAQAccordion faqs={faqs} />

  <RelatedContent items={[
    { title:'Corrugated Boxes', href:'/services/corrugated-boxes', description:'Standard and custom corrugated shipping boxes.' },
    { title:'Design Support', href:'/design-support', description:'Dielines, artwork preparation, proofing, and sample coordination.' },
    { title:'Sustainability', href:'/sustainability', description:'FSC, recycled, and compostable options.' }
  ]} />

  <CTABand
    heading="Send brand assets and dimensions."
    lead="Send the structure, dimensions, artwork scope, quantity, destination, and required delivery date for a product-specific quotation."
    primaryCta={{ label: 'Request a quote', href: '/contact' }}
  />
</BaseLayout>
