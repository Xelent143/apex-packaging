---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import CTABand from '../components/sections/CTABand.astro';
import ProcessTimeline from '../components/sections/ProcessTimeline.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const breadcrumb = buildBreadcrumbSchema([{name:'Home',url:'/'},{name:'About',url:'/about'}]);

const steps = [
  { title: 'Brief', meta: '01', description: 'Send dimensions, quantity, material, artwork, and the required delivery destination and date.' },
  { title: 'Quote', meta: '02', description: 'Apex confirms the product-specific specification, minimum order, production plan, and delivery estimate.' },
  { title: 'Design', meta: '03', description: 'Structural design, dielines, artwork preparation, and proofs are coordinated for approval.' },
  { title: 'Sample', meta: '04', description: 'Digital or physical samples can be arranged to validate fit, structure, print, and finish.' },
  { title: 'Production', meta: '05', description: 'Qualified overseas production facilities manufacture the approved packaging under coordinated quality checks.' },
  { title: 'Deliver', meta: '06', description: 'Apex coordinates shipping and doorstep delivery to Canada, the United States, and international destinations.' }
];
---
<BaseLayout
  title="About Apex Packaging Solutions | Canada-Based Packaging Company"
  description="Apex Packaging Solutions is based in London, Ontario and manages custom packaging projects through qualified overseas production facilities for customers in Canada, the USA and selected international markets."
  schemaBlocks={[breadcrumb]}
>
  <PageHeader
    eyebrow="About"
    heading="Canada-based packaging support from design through delivery."
    lead="Headquartered in London, Ontario, Apex Packaging Solutions supplies custom packaging to businesses across Canada, the United States, and selected international markets. Qualified overseas production facilities manufacture each approved project while Apex coordinates the work from structural design and artwork through sampling, production, quality coordination, and delivery."
  />

  <section class="py-16 md:py-24">
    <div class="container max-w-default prose-apex">
      <h2>What Apex actually does</h2>
      <ul>
        <li>Supplies folding cartons, retail boxes, corrugated shippers, mailer boxes, rigid boxes, and magnetic-closure presentation packaging.</li>
        <li>Coordinates custom pouches, Mylar bags, paper shopping bags, and other flexible or paper-based formats.</li>
        <li>Supports food, bakery, pastry, cake, confectionery, window-box, sleeve, tray, and insert projects.</li>
        <li>Provides structural design, artwork preparation, sampling, custom printing, and premium finishing coordination.</li>
        <li>Manages production through qualified overseas facilities, including specification review, quality coordination, freight, and doorstep delivery.</li>
      </ul>

      <h2>Where Apex works</h2>
      <ul>
        <li><strong>Canada</strong> — Apex is headquartered in London, Ontario and serves businesses across the country.</li>
        <li><strong>United States</strong> — US projects are quoted and managed directly by Apex.</li>
        <li><strong>Selected international markets</strong> — destination, freight method, duties, and delivery timing are reviewed as part of each quotation.</li>
      </ul>
      <p>Product availability, minimum order quantities, production time, and shipping time vary by packaging style, dimensions, material, printing method, quantity, and delivery destination.</p>

      <h2>Capabilities</h2>
      <ul>
        <li><strong>Structural and artwork support</strong> — dielines, print preparation, digital proofs, samples, and production-ready files.</li>
        <li><strong>Production coordination</strong> — material, print, finish, tooling, and schedule management with qualified overseas facilities.</li>
        <li><strong>Quality coordination</strong> — approved specifications, sample review, production checks, and issue follow-through.</li>
        <li><strong>Delivery management</strong> — freight and doorstep delivery coordinated for Canadian, US, and international destinations.</li>
      </ul>

      <h2>A project-specific approach</h2>
      <ul>
        <li><strong>One managed workflow</strong>: Apex stays involved from the initial brief through delivery and reorder planning.</li>
        <li><strong>Broad product selection</strong>: structural boxes, flexible packaging, paper bags, food packaging, inserts, and premium finishes can be reviewed together.</li>
        <li><strong>Specification-led quoting</strong>: recommendations reflect the product, artwork, quantity, destination, and intended use.</li>
        <li><strong>Clear variables</strong>: minimums and timelines are confirmed for the exact packaging style instead of advertised as universal promises.</li>
      </ul>
    </div>
  </section>

  <ProcessTimeline
    eyebrow="A typical engagement"
    heading="From brief to doorstep delivery — six coordinated steps."
    steps={steps}
  />

  <CTABand
    heading="For procurement teams comparing quotes, the right next step is sending the spec."
    primaryCta={{ label: 'Request a quote', href: '/contact' }}
  />
</BaseLayout>
