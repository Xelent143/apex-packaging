  'software-boxes': { title: 'Custom Software Packaging Boxes Canada | Apex Packaging', description: 'Custom software packaging boxes for tech products, kits, manuals and retail programs, with product fit, inserts and print options.', heading: 'Custom software packaging boxes for technology products and retail programs.' },
  'spice-packaging': { title: 'Custom Spice Packaging Boxes Canada | Apex Packaging', description: 'Custom spice packaging boxes for jars, pouches and retail products, with dimensions, display requirements and print options quoted by project.', heading: 'Custom spice packaging boxes for retail products, jars and pouches.' },
