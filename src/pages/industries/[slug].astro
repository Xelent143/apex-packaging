      { option: 'Side-gusset bag', application: 'Traditional roasted-coffee presentation and larger filled formats', tradeoff: 'Uses side expansion efficiently; the filled shape and available front, back, and gusset artwork areas differ from a stand-up pouch.' },
      { option: 'Paperboard carton or sleeve', application: 'Secondary retail presentation, multi-packs, gift sets, and products already sealed in an inner pack', tradeoff: 'Adds display and information panels but does not replace the required primary coffee barrier packaging.' },
      { option: 'Corrugated subscription mailer', application: 'Single-SKU or mixed coffee subscriptions, tasting kits, and ecommerce shipments', tradeoff: 'Supports shipping and unboxing; it must be sized around the filled bags, inserts, literature, and route.' }
    ],
    materials: [
      { option: 'Barrier pouch structure', application: 'Primary coffee bags or pouches where barrier and seal performance are required', tradeoff: 'The structure must be matched to the roast, filling process, intended shelf life, valve, and documentation requirements.' },
      { option: 'Kraft paperboard carton', application: 'Secondary display, grouping, information space, and gift presentation', tradeoff: 'The carton provides structure and print area but relies on a suitable sealed inner package for the coffee.' },
      { option: 'Valve-ready film structure', application: 'Roasted-coffee packs where the product and filling process require degassing', tradeoff: 'Valve suitability, placement, sealing, and the complete film structure must be evaluated together.' },
      { option: 'Corrugated board', application: 'Subscription mailers and ecommerce shipping packs', tradeoff: 'Provides distribution structure; flute, liner, insert, and print choices depend on packed weight and shipping conditions.' }
    ],
    measurements: [
      'Share the coffee format and intended fill weight, then provide a filled reference pack or target filled dimensions after the product settles.',
      'Identify bag width, height, gusset or base depth, headspace, fill opening, and required seal areas.',
      'Mark zipper, tear-notch, valve, barcode, and mandatory-copy zones before artwork is finalized.',
      'For cartons and subscription mailers, measure the complete filled bags plus dividers, cards, samples, and protective material.',
      'Provide the number and orientation of bags per pack, complete packed weight, sales channel, and shipping route.'
    ],
    printing: [
      'Custom-printed pouch film is suited to established artwork and SKU programs; the print process and colour controls are confirmed with the material and order plan.',
      'Matte or gloss appearance and kraft surfaces affect artwork contrast and must be reviewed with the exact material structure.',
      'Paperboard cartons and corrugated mailers use their own compatible print and finish routes; do not assume one colour result across film and board.'
    ],
    sampling: [
      'Provide vector logos where possible, colour references, final copy, barcode files, required information panels, and each approved SKU version.',
      'Confirm the latest bag or box dieline before releasing production artwork, including seals, gussets, folds, zipper, and valve zones.',
      'Use a representative filled sample to evaluate capacity, settling, closure access, shelf stance, carton fit, and subscription-mailer packout.',
      'Confirm which proof or sample is intended to assess layout, colour, material, valve placement, sealing, or full production performance.'
    ],
    commercialFactors: [
      'bag style and dimensions, material construction, closure, valve, and other components;',
      'print coverage, finish, number of SKUs, shared versus separate artwork, and colour-control needs;',
      'cartons, sleeves, inserts, or subscription mailers included in the program;',
      'tooling or cylinders where applicable, samples, artwork readiness, quantity, packing, destination, and documentation requirements.'
    ],
    faqs: [
      { q: 'Which coffee package should I quote first?', a: 'Start with the primary pack that touches or contains the coffee: stand-up pouch or side-gusset bag, including fill weight, barrier, valve, closure, and filling requirements. Add cartons, sleeves, or subscription mailers only after the filled primary pack dimensions are understood.' },
      { q: 'Does a kraft-look coffee bag have the required barrier?', a: 'Not necessarily. Kraft describes appearance, not the full material construction. The product, filling method, required barrier, shelf-life, valve, food-contact, and documentation criteria should be established before a supplier structure is selected.' },
      { q: 'When should a coffee pouch use a degassing valve?', a: 'Valve requirements depend on the coffee, roast timing, filling process, package structure, and intended shelf life. A qualified packaging supplier should determine valve suitability and placement from those inputs; the bag style alone is not enough.' },
      { q: 'How do I size a coffee subscription mailer?', a: 'Measure the actual filled bags after settling, then arrange every bag, card, sample, divider, or protective component in the intended orientation. Share that complete packout, packed weight, and shipping route so the corrugated mailer and any insert can be developed together.' },
      { q: 'What affects coffee-packaging minimums, price, and timing?', a: 'Bag dimensions, material structure, valve and closure, print process, SKU count, cartons or mailers, tooling, samples, artwork readiness, quantity, packing, destination, and documentation needs all affect the plan. A complete supplier quotation should state the project-specific minimum, price, and schedule.' }
    ],
    related: [
      { title: 'Choose material for a stand-up pouch', href: '/blog/how-to-choose-material-for-a-stand-up-pouch', description: 'Prepare barrier, product, closure, and material requirements for supplier review.' },
      { title: 'Select pouch size and capacity', href: '/blog/how-to-select-pouch-size-and-capacity', description: 'Build a size brief around fill weight, filled dimensions, gussets, and seal zones.' },
      { title: 'Printed mailer boxes for subscriptions', href: '/services/mailer-boxes', description: 'Plan the corrugated outer pack around filled coffee bags, inserts, and the shipping route.' }
    ],
    quoteLead: 'For a complete RFQ, send the coffee format and fill weight, target filled dimensions, preferred bag or carton style, required barrier and shelf-life criteria, closure requirements, food-contact or documentation requirements, SKU and artwork count, outer-mailer packout, target quantity, destination, and timing context.'
  }
};
const buyerContent = buyerContentBySlug[box.slug];

const productFAQs: Record<string, { q: string; a: string }> = {
  'bakery-boxes': {
    q: 'What should I include in a bakery-box quotation request?',
    a: 'Include the product dimensions, packed height, quantity, artwork status, preferred structure, any material or food-contact documentation requirement, and delivery destination. Apex confirms the suitable options in the quotation.'
  },
  'custom-mylar-bags': {
    q: 'What details determine a custom pouch or Mylar-bag quotation?',
    a: 'Share the product, pouch dimensions or fill volume, material or barrier needs, closure features, print coverage, quantity and delivery destination. Availability, minimums, timing and price are confirmed for that specification.'
  },
  'cosmetic-boxes': {
    q: 'What should cosmetic brands send for a box quotation?',
    a: 'Share the product dimensions, bottle or jar shape, required insert support, artwork, print and finish preferences, quantity and delivery destination. Apex can then quote the appropriate structure and sample path.'
  },
  'candle-boxes': {
    q: 'How are candle boxes specified for jars and gift sets?',
    a: 'Provide the jar or tin dimensions, packed weight, whether an insert is required, artwork, finish preferences, quantity and delivery destination. The recommended structure, minimums and timing depend on those details.'
  },
  'apparel-boxes': {
    q: 'What should I send for an apparel-box quotation?',
    a: 'Share folded garment dimensions, packed weight, order mix, desired presentation, artwork, quantity and delivery destination. Apex can recommend a mailer, carton or presentation-box structure for the program.'
  }
};

const supportingGuidesBySlug: Record<string, { title: string; href: string; description: string }[]> = {
  'bakery-boxes': [
    { title: 'Choosing the right bakery box size', href: '/blog/how-to-choose-the-right-bakery-box-size', description: 'Measure cakes, pastries and cupcakes for a practical box specification.' },
    { title: 'What affects custom bakery-box cost?', href: '/blog/how-much-do-custom-bakery-boxes-cost', description: 'Understand the variables that shape a bakery-box quotation.' },
    { title: 'Kraft vs cardboard bakery boxes', href: '/blog/kraft-vs-cardboard-bakery-boxes', description: 'Compare presentation, printing and handling considerations.' }
  ],
  'custom-mylar-bags': [
    { title: 'How to choose stand-up pouch material', href: '/blog/how-to-choose-material-for-a-stand-up-pouch', description: 'Compare material considerations before requesting a pouch quotation.' },
    { title: 'Choosing pouch size and capacity', href: '/blog/how-to-select-pouch-size-and-capacity', description: 'Prepare a pouch-size brief around the product and pack format.' },
    { title: 'Pouch zippers, tear notches and windows', href: '/blog/pouch-zippers-tear-notches-and-windows', description: 'Select practical pouch features before quoting.' }
  ],
  'cosmetic-boxes': [
    { title: 'Cosmetic packaging for retail launches', href: '/blog/cosmetic-packaging-boxes-for-retail-launches-2026-09-20', description: 'Colour, insert and sample considerations for retail beauty packaging.' }
  ],
  'candle-boxes': [
    { title: 'Custom box inserts for safer product presentation', href: '/blog/custom-box-inserts-for-safer-product-presentation-2026-09-07', description: 'Review insert choices for jars, gift sets and fragile contents.' }
  ],
  'apparel-boxes': [
    { title: 'Apparel mailer packaging for ecommerce brands', href: '/blog/apparel-mailer-packaging-ecommerce-returns-guide', description: 'Compare mailers, boxes and return considerations for ecommerce apparel.' }
  ]
};
const supportingGuides = buyerContent?.related ?? supportingGuidesBySlug[box.slug] ?? [];

const defaultFaqs = [
  {
    q: `Can Apex supply custom ${box.label.toLowerCase()} with my logo?`,
    a: `Yes. Apex can coordinate ${box.label.toLowerCase()} with brand print, custom dimensions, material selection, production-ready dielines, sampling, overseas production, and delivery.`
  },
  {
    q: `What is the minimum order for ${box.label.toLowerCase()}?`,
    a: 'Minimum order quantities vary by packaging style, size, material, printing method, quantity, and delivery destination. Contact Apex for a product-specific quotation.'
  },
  {
    q: 'Can I get a sample before production?',
    a: 'Yes. Apex can prepare a digital proof and quote pre-production samples so fit, structure, and print placement are confirmed before the full run.'
  },
  ...(productFAQs[box.slug] ? [productFAQs[box.slug]] : [])
];
const faqs = buyerContent?.faqs ?? defaultFaqs;

const breadcrumb = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Boxes by Industry', url: '/industries' },
  { name: box.label, url: `/industries/${box.slug}` }
]);

const service = buildServiceSchema({
  name: `Custom ${box.label} supplier`,
  description: box.summary,
  url: `/industries/${box.slug}`
});
---
<BaseLayout
  title={metaTitle}
  description={metaDescription}
  image={heroImage}
  schemaBlocks={[breadcrumb, service, buildFAQSchema(faqs)]}
>
  <section class="relative overflow-hidden border-b border-neutral-200 bg-white">
    <p class="sr-only">Custom {box.label}</p>
    <img
      src={heroImage}
      alt={`${box.label} custom packaging hero banner`}
      width="2172"
      height="724"
      class="aspect-[2172/724] w-full object-cover object-center"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <HeroFeatureStrip items={heroFeatureItems} />
  </section>

  {box.slug === 'coffee-packaging' && (
    <section class="overflow-hidden border-b border-neutral-200 bg-[#f5f1e9] py-4 md:py-6" aria-label="Coffee packaging bag mockup slider">
      <div class="coffee-packaging-track flex w-max gap-4 px-4 md:gap-6 md:px-6">
        {[...coffeePackagingSlides, ...coffeePackagingSlides].map((slide, index) => (
          <article class="group relative w-[82vw] max-w-[31rem] shrink-0 overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-card sm:w-[48vw] lg:w-[32vw]">
            <img
              src={slide.src}
              alt={slide.alt}
              width="1200"
              height="760"
              loading={index < 3 ? 'eager' : 'lazy'}
              decoding="async"
              class="aspect-[1200/760] w-full object-cover transition duration-500 group-hover:scale-[1.025]"
            />
          </article>
        ))}
      </div>
    </section>
  )}

  <style>
    .coffee-packaging-track {
      animation: coffee-packaging-scroll 34s linear infinite;
      will-change: transform;
    }

    .coffee-packaging-track:hover {
      animation-play-state: paused;
    }

    @keyframes coffee-packaging-scroll {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(-50%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .coffee-packaging-track {
        animation: none;
        max-width: 100%;
        overflow-x: auto;
      }
    }
  </style>

  <section id="details" class="scroll-mt-28 bg-neutral-50 py-12 md:scroll-mt-32 md:py-24">
    <div class="container max-w-wide">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class:list={[buyerContent ? 'lg:col-span-8' : 'lg:col-span-5']}>
          <p class="eyebrow">Packaging details</p>
          <h1 class="mt-3 font-display text-3xl font-extrabold leading-tight text-neutral-900 md:text-5xl">{commercialKeyword}</h1>
          <p class="mt-4 text-base leading-relaxed text-neutral-600 md:mt-5 md:text-lg">
            {buyerContent?.intro ?? `${commercialHeading} Apex starts with dimensions, product weight, retail or shipping use, print goals, and target quantity. From there, the team recommends structure, board grade, print method, and sample path.`}
          </p>
        </div>
        {!buyerContent && <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7 lg:gap-5">
          <article class="rounded-md border border-neutral-200 bg-white p-5 shadow-card md:p-6">
            <h3 class="font-display text-xl font-extrabold text-neutral-900">Best For</h3>
            <ul class="mt-4 space-y-2 text-neutral-600">
              {box.bestFor.map((item) => <li class="flex gap-2"><span class="font-bold text-accent">•</span><span>{item}</span></li>)}
            </ul>
          </article>
          <article class="rounded-md border border-neutral-200 bg-white p-5 shadow-card md:p-6">
            <h3 class="font-display text-xl font-extrabold text-neutral-900">Materials</h3>
            <ul class="mt-4 space-y-2 text-neutral-600">
              {box.materials.map((item) => <li class="flex gap-2"><span class="font-bold text-accent">•</span><span>{item}</span></li>)}
            </ul>
          </article>
          <article class="rounded-md border border-neutral-200 bg-white p-5 shadow-card md:p-6">
            <h3 class="font-display text-xl font-extrabold text-neutral-900">Box Styles</h3>
            <ul class="mt-4 space-y-2 text-neutral-600">
              {box.styles.map((item) => <li class="flex gap-2"><span class="font-bold text-accent">•</span><span>{item}</span></li>)}
            </ul>
          </article>
          <article class="rounded-md border border-neutral-200 bg-white p-5 shadow-card md:p-6">
            <h3 class="font-display text-xl font-extrabold text-neutral-900">Print Options</h3>
            <ul class="mt-4 space-y-2 text-neutral-600">
              {box.printOptions.map((item) => <li class="flex gap-2"><span class="font-bold text-accent">•</span><span>{item}</span></li>)}
            </ul>
          </article>
        </div>}
      </div>
    </div>
  </section>

  {buyerContent && (
    <>
      <section class="border-y border-neutral-200 bg-white py-12 md:py-20">
        <div class="container max-w-wide">
          <div class="grid gap-10 lg:grid-cols-2">
            <article class="min-w-0">
              <p class="eyebrow">Structures and applications</p>
              <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-neutral-900 md:text-4xl">Select the format around the product and buying use.</h2>
              <div class="mt-7 overflow-x-auto rounded-md border border-neutral-200">
                <table class="min-w-[680px] w-full border-collapse text-left text-sm leading-relaxed">
                  <thead class="bg-neutral-900 text-white">
                    <tr><th class="p-4">Structure</th><th class="p-4">Suitable applications</th><th class="p-4">Trade-off to evaluate</th></tr>
                  </thead>
                  <tbody>
                    {buyerContent.structures.map((row) => (
                      <tr class="border-t border-neutral-200 align-top">
                        <th scope="row" class="p-4 font-bold text-neutral-900">{row.option}</th>
                        <td class="p-4 text-neutral-600">{row.application}</td>
                        <td class="p-4 text-neutral-600">{row.tradeoff}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </article>
            <article class="min-w-0">
              <p class="eyebrow">Material choices</p>
              <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-neutral-900 md:text-4xl">Compare appearance, performance, and packout.</h2>
              <div class="mt-7 overflow-x-auto rounded-md border border-neutral-200">
                <table class="min-w-[680px] w-full border-collapse text-left text-sm leading-relaxed">
                  <thead class="bg-neutral-900 text-white">
                    <tr><th class="p-4">Material direction</th><th class="p-4">Suitable applications</th><th class="p-4">Trade-off to evaluate</th></tr>
                  </thead>
                  <tbody>
                    {buyerContent.materials.map((row) => (
                      <tr class="border-t border-neutral-200 align-top">
                        <th scope="row" class="p-4 font-bold text-neutral-900">{row.option}</th>
                        <td class="p-4 text-neutral-600">{row.application}</td>
                        <td class="p-4 text-neutral-600">{row.tradeoff}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="border-b border-neutral-200 bg-neutral-50 py-12 md:py-20">
        <div class="container max-w-wide">
          <div class="grid gap-5 md:grid-cols-2">
            <article class="rounded-md border border-neutral-200 bg-white p-6 shadow-card md:p-8">
              <p class="eyebrow">Measurement and fit</p>
              <h2 class="mt-3 font-display text-2xl font-extrabold text-neutral-900 md:text-3xl">Measure the complete packout.</h2>
              <ul class="mt-5 space-y-3 text-base leading-relaxed text-neutral-600">
                {buyerContent.measurements.map((item) => <li class="flex gap-3"><span class="font-black text-accent">•</span><span>{item}</span></li>)}
              </ul>
            </article>
            <article class="rounded-md border border-neutral-200 bg-white p-6 shadow-card md:p-8">
              <p class="eyebrow">Printing and finishing</p>
              <h2 class="mt-3 font-display text-2xl font-extrabold text-neutral-900 md:text-3xl">Design for the selected material.</h2>
              <ul class="mt-5 space-y-3 text-base leading-relaxed text-neutral-600">
                {buyerContent.printing.map((item) => <li class="flex gap-3"><span class="font-black text-accent">•</span><span>{item}</span></li>)}
              </ul>
            </article>
            <article class="rounded-md border border-neutral-200 bg-white p-6 shadow-card md:p-8">
              <p class="eyebrow">Artwork and samples</p>
              <h2 class="mt-3 font-display text-2xl font-extrabold text-neutral-900 md:text-3xl">Approve the right proof for each decision.</h2>
              <ul class="mt-5 space-y-3 text-base leading-relaxed text-neutral-600">
                {buyerContent.sampling.map((item) => <li class="flex gap-3"><span class="font-black text-accent">•</span><span>{item}</span></li>)}
              </ul>
            </article>
            <article class="rounded-md border border-neutral-200 bg-white p-6 shadow-card md:p-8">
              <p class="eyebrow">Commercial planning</p>
              <h2 class="mt-3 font-display text-2xl font-extrabold text-neutral-900 md:text-3xl">What changes minimums, price, and timing.</h2>
              <p class="mt-4 text-base leading-relaxed text-neutral-600">A complete quotation requires:</p>
              <ul class="mt-5 space-y-3 text-base leading-relaxed text-neutral-600">
                {buyerContent.commercialFactors.map((item) => <li class="flex gap-3"><span class="font-black text-accent">•</span><span>{item}</span></li>)}
              </ul>
              <p class="mt-5 text-base font-semibold leading-relaxed text-neutral-800">There is no universal minimum, price, or lead time that applies to every specification.</p>
            </article>
          </div>
        </div>
      </section>
    </>
  )}

  {!buyerContent && <section class="border-y border-neutral-200 bg-white py-12 md:py-24">
    <div class="container max-w-wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-4">
          <p class="eyebrow">How Apex manages it</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-neutral-900 md:text-4xl">From dieline through production and delivery.</h2>
        </div>
        <div class="grid gap-4 lg:col-span-8">
          {box.manufacturerNotes.map((note, index) => (
            <article class="grid gap-3 rounded-md border border-neutral-200 bg-neutral-50 p-4 shadow-sm md:grid-cols-[auto_1fr] md:items-center md:gap-4 md:p-5">
              <span class="grid h-12 w-12 place-items-center rounded-md bg-accent font-mono text-sm font-black text-neutral-900">0{index + 1}</span>
              <p class="text-base font-semibold leading-relaxed text-neutral-800 md:text-lg">{note}</p>
            </article>
          ))}
          <article class="grid gap-3 rounded-md border border-[#c8dbdd] bg-[#eef6f6] p-4 md:grid-cols-[auto_1fr] md:items-center md:gap-4 md:p-5">
            <span class="grid h-12 w-12 place-items-center rounded-md bg-[#1f6672] font-mono text-sm font-black text-white">RFQ</span>
            <p class="text-base font-semibold leading-relaxed text-neutral-800 md:text-lg">
              {buyerContent?.quoteLead ?? 'Send dimensions, quantity, artwork, product weight, and launch date. Apex will return a practical material, structure, and pricing recommendation.'}
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>}

  <FAQAccordion faqs={faqs} />

  <RelatedContent
    heading={supportingGuides.length ? `Guides for ${box.label.toLowerCase()} buyers` : undefined}
    items={(supportingGuides.length ? supportingGuides : related.map((item) => ({
      title: item.label,
      href: `/industries/${item.slug}`,
      description: item.summary
    }))).slice(0, 3)}
  />

  <CTABand
    heading={buyerContent ? `Request a ${box.label.toLowerCase()} quotation` : `Need custom ${box.label.toLowerCase()}?`}
    lead={buyerContent?.quoteLead ?? 'Share the product size, material preference, quantity, and target delivery date. Apex will recommend the right box structure and print path.'}
    primaryCta={{ label: 'Send your specs', href: '/contact' }}
  />
</BaseLayout>
