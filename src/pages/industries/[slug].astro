  'hardware-boxes': { title: 'Custom Hardware Packaging Boxes Canada | Apex Packaging', description: 'Custom hardware packaging boxes for parts, tools and retail kits, specified for product weight, organization, print and delivery requirements.', heading: 'Custom hardware packaging boxes for parts, tools and retail programs.' },
