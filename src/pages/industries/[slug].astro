  'cigarette-boxes': { title: 'Custom Cigarette Packaging Boxes Canada | Apex Packaging', description: 'Custom cigarette packaging boxes and small-format retail cartons with production specifications and required information panels reviewed by project.', heading: 'Custom cigarette packaging boxes for small-format retail programs.' },
  'coffee-packaging': { title: 'Custom Coffee Packaging Wholesale Canada | Apex Packaging', description: 'Custom coffee packaging for roasters, subscriptions and retail programs, including pouches, cartons, mailers and product-specific print options.', heading: 'Custom coffee packaging for wholesale, retail and subscription programs.' },
  'cosmetic-boxes': { title: 'Custom Cosmetic Packaging Boxes Canada | Apex Packaging', description: 'Custom cosmetic packaging boxes for skincare, makeup, jars and beauty retail launches, with structures, inserts, printing and finishes quoted to specification.', heading: 'Custom cosmetic packaging boxes for beauty products, retail presentation and launch planning.' },
  'custom-kraft-soap-boxes': { title: 'Custom Kraft Soap Boxes Wholesale Canada | Apex Packaging', description: 'Custom kraft soap boxes for handmade soap, skincare and wellness retail, with sleeves, windows, print and product-specific quotation support.', heading: 'Custom kraft soap boxes for wholesale and retail packaging programs.' },
  'custom-mylar-bags': { title: 'Custom Printed Mylar Bags Wholesale Canada | Apex Packaging', description: 'Custom printed Mylar bags and pouches for retail products, with material, size, closure, print and project-specific quote requirements.', heading: 'Custom printed Mylar bags for wholesale and retail pouch programs.' },
  'custom-tuck-boxes': { title: 'Custom Tuck End Packaging Boxes Canada | Apex Packaging', description: 'Custom tuck end packaging boxes for retail products, cosmetics, supplements and lightweight goods, with material and print options quoted by project.', heading: 'Custom tuck end packaging boxes for retail products and product launches.' },
