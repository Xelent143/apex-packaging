---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import CTABand from '../components/sections/CTABand.astro';
---
<BaseLayout
  title="Payment Cancelled | Apex Packaging Solutions"
  description="Your Apex Packaging Solutions Stripe checkout was cancelled."
  noindex
>
  <PageHeader
    eyebrow="Payment cancelled"
    heading="No payment was completed."
    lead="The private secure checkout link was not completed. Contact Apex if the approved amount, currency, or quote number needs to be checked before a fresh link is issued."
  />

  <CTABand
    heading="Need a new secure link?"
    lead="Apex will issue a fresh fixed-amount Stripe checkout link after confirming the approved order details."
    primaryCta={{ label: 'Contact Apex', href: '/contact' }}
    secondaryCta={{ label: 'Email sales', href: 'mailto:sales@apexpackagingsolutions.com' }}
  />
</BaseLayout>
