---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import CTABand from '../components/sections/CTABand.astro';
import { buildBreadcrumbSchema } from '../lib/schema';
const breadcrumb = buildBreadcrumbSchema([{name:'Home',url:'/'},{name:'Sustainability',url:'/sustainability'}]);
---
<BaseLayout
  title="Packaging Material Options | Apex Packaging"
  description="Discuss material, recycled-content, food-contact, certification and end-of-life requirements with Apex for a product-specific packaging quotation."
  schemaBlocks={[breadcrumb]}
>
  <PageHeader
    eyebrow="Sustainability"
    heading="Packaging material options, reviewed for the exact project."
    lead="Material, certification, recycled-content and end-of-life requirements depend on the packaging format, production facility, destination and available documentation. Apex reviews those requirements as part of a product-specific quotation."
  />
  <section class="py-16 md:py-24">
    <div class="container max-w-default prose-apex">
      <h2>Confirm requirements before specifying a material</h2>
      <p>Apex can discuss board, paper, film, coatings, inks, recycled-content requests, food-contact requirements, or third-party certification requirements. Availability and documentation must be confirmed for the exact product and production run.</p>

      <h2>Documentation is product-specific</h2>
      <p>Do not assume a certification, recycled-content percentage, compostability claim, recyclability claim, food-contact statement, or environmental attribute applies to every packaging option. Ask for the documentation required for your product, destination and intended use before approving production.</p>

      <h2>What to include in your request</h2>
      <ul>
        <li>Packaging style, dimensions, material preference and quantity.</li>
        <li>Any food-contact, recycled-content, certification or disposal requirement.</li>
        <li>Artwork, printing and finish requirements.</li>
        <li>Delivery destination and required delivery date.</li>
      </ul>
      <p>Apex will confirm available options, applicable documentation, production timing and delivery terms in the quotation.</p>
    </div>
  </section>
  <CTABand
    heading="Have a material or documentation requirement?"
    lead="Send the specification and Apex will confirm available options and documentation for the proposed product."
    primaryCta={{ label: 'Send your spec', href: '/contact' }}
  />
</BaseLayout>
