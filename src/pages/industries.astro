---
import PackagingBanner from '../components/sections/PackagingBanner.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/sections/CTABand.astro';
import { buildBreadcrumbSchema, buildFAQSchema } from '../lib/schema';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import { industryBoxes } from '../data/industryBoxes';
const breadcrumb = buildBreadcrumbSchema([{name:'Home',url:'/'},{name:'Industries',url:'/industries'}]);

const verticals = [
  {
    name: 'Automotive parts manufacturers',
    image: 'automotive-parts',
    alt: 'Apex Packaging branded corrugated cartons, VCI bags, and die-cut inserts for automotive parts',
    meta: 'VCI protection · double-wall cartons · custom inserts',
    tags: ['Engine components', 'Fasteners', 'OEM plant shipments'],
    body: 'Heavy single-wall and double-wall corrugated for engine components, body panels, and aftermarket accessories. Custom dieline inserts to immobilize parts. VCI rust-prevention for ferrous components. Wicketed polybags for high-speed bagging lines on small fasteners and trim. Typical buyer: a tier-2 supplier shipping daily into an OEM plant.'
  },
  {
    name: 'Food and beverage producers',
    image: 'food-beverage',
    alt: 'Apex Packaging branded food cartons, bread bags, produce bags, and corrugated shipper',
    meta: 'Retail cartons · produce bags · bakery liners',
    tags: ['Seasonal volume', 'Retail cartons', 'Documentation review'],
    body: 'Wicketed produce bags, pound bags, gusseted bread bags, bakery liners and custom-printed retail cartons. Food-contact and documentation requirements are reviewed for the exact product and intended use. Typical buyer: a regional food brand or co-packer with seasonal volume swings.'
  },
  {
    name: 'Pharmaceuticals and medical devices',
    image: 'pharma-medical',
    alt: 'Apex Packaging branded medical-device cartons, sterile pouches, and cold-chain insulated shipper',
    meta: 'Tamper-evident options · protective packaging · documentation review',
    tags: ['Audit-ready specs', 'Tamper-evident', 'Cold-chain support'],
    body: 'Corrugated shipping, protective packaging, insulating-carton and tamper-evident options. Material, handling and documentation requirements are reviewed for the intended application. Typical buyer: a regulated manufacturer with audit-ready packaging requirements.'
  },
  {
    name: 'Electronics and high-tech',
    image: 'electronics-high-tech',
    alt: 'Apex Packaging branded electronics mailer with anti-static bags and ESD foam inserts',
    meta: 'Protective bags · foam inserts · specification review',
    tags: ['PCBs and instruments', 'Humidity control', 'Custom-cut foam'],
    body: 'Protective polybags, foam inserts, corner pads, VCI bagging and custom-cut foam for instruments, PCBs and assembled units. Protection, static-control and test requirements are reviewed for the exact application. Typical buyer: an OEM or contract manufacturer with humidity and ESD requirements.'
  },
  {
    name: 'Industrial supply and MRO distribution',
    image: 'industrial-mro',
    alt: 'Apex Packaging branded bulk cartons, pallet wrap, strapping, and edge protectors',
    meta: 'Bulk cartons · stretch film · blanket PO releases',
    tags: ['Pallet quantities', 'Truckload programs', 'Edge protection'],
    body: 'Bulk corrugated, stretch and shrink film at pallet quantities, edge protectors, strapping. Scheduled releases against blanket POs. Single account manager. Typical buyer: an industrial distributor running multiple monthly truckloads.'
  },
  {
    name: 'E-commerce and D2C brands',
    image: 'ecommerce-d2c',
    alt: 'Apex Packaging branded mailer boxes, polymailer, tape, tissue paper, and insert card',
    meta: 'Mailer boxes · polymailers · branded inserts',
    tags: ['Product-specific MOQ', 'Dieline support', 'Subscription-ready'],
    body: 'Custom-printed mailer boxes, custom polymailers, tissue paper, branded tape, and inserts. Apex coordinates dielines, artwork, mockups, sampling, production, and delivery according to the project specification. Typical buyer: a D2C brand managing launch, subscription, or reorder packaging.'
  }
];

const buyerFaqs = [
  {
    "q": "Which packaging format is right for my product: folding carton, rigid box, corrugated box or pouch?",
    "a": "Start with the product dimensions, packed weight, sales channel and handling route. Tuck cartons, pillow boxes and sleeves suit many lightweight retail products; rigid and gift boxes add presentation; corrugated mailers and shippers provide transit protection. Display boxes need a retail footprint and replenishment plan, while window packaging needs a suitable opening and film. Share the product and how it will be sold or shipped so Apex can compare structures, materials and inserts for the actual use."
  },
  {
    "q": "What information do I need for a custom packaging quote in Canada or the USA?",
    "a": "Send the product name, photos, dimensions, packed weight, preferred structure, quantity per size or artwork version, printing and finish requirements, delivery postal or ZIP code, and required arrival date. Identify whether dimensions are internal or external and use consistent units; allow for inserts and product clearance. If the final specification is undecided, send what you know. Ask the quotation to identify currency, setup or tooling, samples, freight, taxes and any import charges or responsibilities so prices can be compared on the same basis."
  },
  {
    "q": "What is the minimum order quantity, and can I combine different sizes, designs or seasonal products?",
    "a": "Minimums depend on the structure, material, print method and manufacturing setup; there is no single minimum covering every listed product. Different sizes, inserts or printed designs can have separate setup costs and minimums. For small launches, Christmas or holiday boxes, and multi-SKU retail ranges, ask Apex to compare available options such as a shared structure with different sleeves or labels. Quantity tiers and whether designs can be combined are confirmed in the project quotation."
  },
  {
    "q": "Can you print my logo, brand colours, barcodes and Canadian or US label information?",
    "a": "Share vector artwork where available, fonts, colour references, barcode files and approved label copy. Apex confirms the dieline and artwork-preparation scope before production. Foil, embossing, windows and coatings need suitable panel space and material. Screen colours are not a printed colour standard, and barcodes need appropriate size, contrast and clear space. Canadian food labels generally require English and French, subject to exemptions; other product and market rules vary. Have your responsible reviewer approve the final market-specific text before print approval."
  },
  {
    "q": "Can I approve a proof or physical packaging sample before placing the production order?",
    "a": "Ask which digital proofs, structural samples or printed samples are available for your specification, along with their cost and timing. A digital proof helps check artwork placement and wording; a physical sample helps assess product fit, closures, inserts, assembly and presentation. They answer different questions. Where colour, shelf display or transit performance matters, agree on the appropriate sample and testing steps before production release. Keep the approved specification and sample reference for reorders."
  },
  {
    "q": "How long does custom packaging take, and can you deliver to Canada and the USA?",
    "a": "Apex serves Canadian and US buyers through its Canada-based project team and qualified overseas production facilities. Timing depends on the structure, materials, artwork approval, sampling, production and freight method; it is confirmed for the project rather than promised as one standard turnaround. Provide the destination and required in-hand date before approval. Confirm whether the quotation includes freight, customs clearance, duties, taxes and final delivery, and who handles each step. Production time and shipping time should be shown separately."
  },
  {
    "q": "What should I check for food, bakery, pizza, chocolate, cereal, coffee, tea and spice packaging?",
    "a": "Identify whether food touches the packaging directly or sits inside a separate primary pack. Tell Apex the food type, grease and moisture exposure, filling temperature, storage conditions and intended use. Request material and component documentation appropriate to that use, including relevant coatings, inks, adhesives, windows or liners. A retail carton alone does not establish food-contact suitability, shelf life, freezer performance or heat resistance. Review the finished pack against the applicable Canadian or US food-contact and labelling requirements before approval."
  },
  {
    "q": "How do I choose a Mylar bag or pouch, including its size, barrier and closure features?",
    "a": "Start with the product form, fill amount or volume, target shelf life and filling or sealing process. Compare the proposed film structure and required moisture, oxygen or light protection; the name Mylar alone is not a complete material specification. Confirm usable dimensions, gusset, seal area, zipper, tear notch, window and hang-hole needs. For food, supplements or wellness products, request documentation for the intended application and validate the pack with the actual product before relying on a shelf-life or compatibility claim."
  },
  {
    "q": "How can packaging protect bottles, candles, kitchenware, electronics, auto parts and hardware during shipping?",
    "a": "Choose the outer carton and internal protection together around the packed weight, fragility, sharp edges and delivery route. Dividers, corrugated inserts, foam, cushioning and suitable closures can limit movement and contact between items. Liquids may need separate leak containment. Electronics may require specified static-control protection, while metal parts may need corrosion protection. A decorative retail or rigid box may still need an outer shipper. Agree on sample packing and any handling, drop, vibration or compression checks needed for the intended shipment."
  },
  {
    "q": "Can rigid, gift and retail boxes be customized for cosmetics, soap, apparel, hair extensions and other premium products?",
    "a": "Share the product layout, retail or gifting use and desired opening experience. Rigid, drawer, sleeve, pillow, tuck and window formats can be compared for cosmetics, soap, apparel, hair extensions, jewellery, software kits, stationery and sports products. Inserts and dividers should fit the actual items, and windows or finishes should support the selected structure. Check for scent, oil, moisture or scuff exposure where relevant. Apex confirms available materials, finishes, assembly requirements and costs for the chosen design; presentation packaging and shipping protection should be reviewed separately."
  },
  {
    "q": "What extra specifications apply to CBD, hemp, pre-roll, vape, cigarette, pharmaceutical and health-product packaging?",
    "a": "Identify the exact product category and every country, province or state where it will be sold before artwork or structure is approved. Depending on the product and market, requirements can include child resistance, tamper evidence, warnings, label content, branding limits or documented material performance. A magnetic closure, gift format or tamper seal does not by itself demonstrate child resistance or regulatory compliance. Supply approved label copy and required specifications or test evidence, and have the responsible product or regulatory reviewer approve the finished packaging."
  },
  {
    "q": "Are kraft boxes, paperboard, windows and pouches recyclable or available with recycled content?",
    "a": "Ask about the complete finished pack, including coatings, laminates, windows, foil, adhesives and inserts. Kraft appearance does not establish recycled content, and a paper outer layer does not make a laminated pouch recyclable. Recycled content, recyclability and compostability are different claims and need appropriate evidence. Collection and processing options vary by Canadian municipality and US community. Ask Apex to review material options and available documentation for the exact specification, then use disposal instructions and environmental claims that match the material and intended market."
  }
];

const pageStats = [
  { label: 'Verticals pictured', value: '06' },
  { label: 'Markets served', value: 'Global' },
  { label: 'Workflow', value: 'End-to-end' }
];

---
<BaseLayout
  title="Custom Packaging by Product Category | Apex"
  description="Browse packaging pages for apparel, bakery, cosmetics, food, retail, shipping, pharmaceuticals and other product categories."
  image="/images/home/hero-ultra/signature-collection-branded.webp"
  schemaBlocks={[breadcrumb, buildFAQSchema(buyerFaqs)]}
>
  <h1 class="sr-only">Custom packaging by product category.</h1>
  <PackagingBanner />
  <section id="industries-grid" class="scroll-mt-28 border-b border-neutral-200 bg-white py-10 md:scroll-mt-32 md:py-16">
    <div class="container max-w-wide">
      <p class="mb-6 text-sm text-neutral-600">Buying packaging in Canada or the USA? <a href="#industry-buyer-faqs" class="font-semibold text-accent underline underline-offset-4">Read 12 buyer FAQs</a> about choosing, quoting and ordering the products below.</p>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:grid-cols-4 xl:grid-cols-6">
        {industryBoxes.map((box) => (
          <a href={`/industries/${box.slug}`} class="group overflow-hidden rounded-md border border-neutral-200 bg-neutral-50 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-accent hover:shadow-card">
            <img
              src={box.image}
              alt={box.alt}
              width="640"
              height="420"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full bg-neutral-100 object-cover transition duration-200 group-hover:scale-[1.03]"
            />
            <div class="p-3 md:p-4">
              <h2 class="font-display text-sm font-extrabold leading-tight text-neutral-900 md:text-lg">{box.label}</h2>
              <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-neutral-600 md:line-clamp-3 md:text-sm">{box.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <div id="industry-buyer-faqs" class="scroll-mt-28 md:scroll-mt-32">
    <FAQAccordion
      heading="Packaging FAQs for buyers in Canada and the USA"
      eyebrow="Before you order"
      intro="Twelve practical answers covering the product categories above, from custom sizes and print approval to food-contact requirements, transit protection and material choices."
      panelHeading="Choose, specify and order"
      faqs={buyerFaqs}
    />
    <div class="container max-w-wide pb-10">
      <p class="text-sm leading-relaxed text-neutral-600">Buyer resources: <a href="https://www.canada.ca/en/health-canada/services/food-nutrition/food-safety/packaging-materials.html" class="underline underline-offset-4">Health Canada food packaging</a> · <a href="https://www.fda.gov/food/packaging-food-contact-substances-fcs/determining-regulatory-status-components-food-contact-material" class="underline underline-offset-4">FDA food-contact materials</a> · <a href="https://inspection.canada.ca/en/food-labels/labelling/consumers/understanding-food-labels" class="underline underline-offset-4">Canadian food labels</a> · <a href="https://www.ftc.gov/business-guidance/resources/environmental-claims-summary-green-guides" class="underline underline-offset-4">FTC environmental claims</a> · <a href="https://competition-bureau.canada.ca/en/how-we-foster-competition/education-and-outreach/environmental-claims-and-greenwashing" class="underline underline-offset-4">Competition Bureau environmental claims</a>.</p>
    </div>
  </div>
  <section class="border-b border-neutral-200 bg-[#f7f2e8] py-8 md:py-10">
    <div class="container max-w-wide">
      <div class="grid gap-5 md:grid-cols-[1.2fr_0.8fr] md:items-end">
        <div>
          <p class="eyebrow mb-4">Industry analysis</p>
          <h2 class="text-3xl font-bold md:text-5xl">The package changes with the risk.</h2>
          <p class="mt-3 max-w-3xl text-base leading-[1.65] text-neutral-600 md:mt-4 md:text-[1.0625rem] md:leading-[1.7]">
            Each vertical below has a different failure point: corrosion, food compliance, sterile handling, static discharge, pallet damage, or customer unboxing. The photos show the kind of branded packaging mix Apex develops around those constraints.
          </p>
        </div>
        <div class="grid grid-cols-3 overflow-hidden rounded-lg border border-neutral-200 bg-neutral-50">
          {pageStats.map((stat) => (
            <div class="border-r border-neutral-200 p-4 last:border-r-0 md:p-5">
              <p class="font-mono text-2xl font-bold text-accent">{stat.value}</p>
              <p class="mt-1 text-xs font-bold uppercase leading-snug text-neutral-700">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="bg-neutral-50 py-12 md:py-24">
    <div class="container max-w-wide">
      <div class="space-y-5 md:space-y-10">
        {verticals.map((v, i) => (
          <article class="grid overflow-hidden rounded-lg border border-neutral-200 bg-white shadow-sm md:grid-cols-12">
            <figure class={`relative min-h-[210px] bg-neutral-100 md:col-span-5 md:min-h-[260px] ${i % 2 === 1 ? 'md:order-2' : ''}`}>
              <img
                src={`/images/industries/${v.image}.webp`}
                alt={v.alt}
                width="1280"
                height="960"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="h-full min-h-[210px] w-full object-cover md:min-h-[260px]"
              />
              <span class="absolute left-4 top-4 rounded-md bg-neutral-900 px-3 py-2 font-mono text-xs font-bold text-neutral-50">0{i + 1}</span>
            </figure>
            <div class="flex flex-col justify-center p-5 md:col-span-7 md:p-10 lg:p-12">
              <p class="mb-3 text-xs font-bold uppercase text-accent">{v.meta}</p>
              <h2 class="font-display text-2xl font-bold leading-tight text-neutral-900 md:text-4xl">{v.name}</h2>
              <p class="mt-4 text-base leading-[1.65] text-neutral-600 md:mt-5 md:text-[1.0625rem] md:leading-[1.75]">{v.body}</p>
              <div class="mt-6 flex flex-wrap gap-2">
                {v.tags.map((tag) => (
                  <span class="rounded-md border border-neutral-200 bg-neutral-50 px-3 py-2 text-sm font-semibold text-neutral-800">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="mt-12 max-w-3xl text-[0.9375rem] leading-relaxed text-neutral-500">If your vertical isn't listed, it doesn't mean Apex hasn't shipped into it. These six are the most common. <a href="/contact" class="text-accent underline underline-offset-4">Send a brief</a> and Apex's team will confirm fit and timeline.</p>
    </div>
  </section>
  <CTABand
    heading="Get a vertical-specific recommendation."
    lead="Send your industry, product type, and current packaging spec. Apex will recommend material, gauge, and structural approach."
    primaryCta={{ label: 'Send a brief', href: '/contact' }}
  />
</BaseLayout>
