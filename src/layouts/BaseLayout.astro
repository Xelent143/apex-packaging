---
import '../styles/globals.css';
import { siteConfig } from '../site.config';
import { buildMeta } from '../lib/seo';
import { buildOrganizationSchema, buildWebSiteSchema } from '../lib/schema';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';
import TawkToChat from '../components/integrations/TawkToChat.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  schemaBlocks?: object[];
  noindex?: boolean;
}

const { title, description, image, canonical, schemaBlocks = [], noindex = false } = Astro.props;
const meta = buildMeta({ title, description, image, canonical, url: Astro.url });
const schema = [buildOrganizationSchema(), buildWebSiteSchema(), ...schemaBlocks];
const robotsContent = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0F0D0A" />
    <meta name="robots" content={robotsContent} />
    <meta name="geo.region" content={siteConfig.geoRegion} />
    <meta name="geo.placename" content={siteConfig.geoPlacename} />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={meta.image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    </noscript>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 bg-neutral-900 text-neutral-50 px-4 py-2 rounded-md">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <TawkToChat />
    <script is:inline>
      (() => {
        const normalize = (value) => value.replace(/\s+/g, ' ').trim().toLowerCase();

        document.querySelectorAll('.prose-apex > h2').forEach((heading, headingIndex) => {
          if (normalize(heading.textContent || '') !== 'frequently asked questions') return;

          const entries = [];
          const consumed = [];
          let node = heading.nextElementSibling;

          while (node && node.tagName !== 'H2') {
            if (node.tagName === 'H3' && node.nextElementSibling?.tagName === 'P') {
              entries.push({ question: node.textContent || '', answer: node.nextElementSibling.innerHTML });
              consumed.push(node, node.nextElementSibling);
              node = node.nextElementSibling.nextElementSibling;
              continue;
            }

            if (node.tagName === 'SECTION') {
              const question = node.querySelector(':scope > h3');
              const answer = node.querySelector(':scope > p');
              if (question && answer) {
                entries.push({ question: question.textContent || '', answer: answer.innerHTML });
                consumed.push(node);
                node = node.nextElementSibling;
                continue;
              }
            }

            break;
          }

          if (!entries.length) return;

          const section = document.createElement('section');
          section.className = 'site-faq site-faq--embedded';
          section.setAttribute('aria-labelledby', `article-faq-heading-${headingIndex + 1}`);

          const container = document.createElement('div');
          container.className = 'site-faq__container';
          const headingGrid = document.createElement('div');
          headingGrid.className = 'site-faq__heading-grid';
          const headingBlock = document.createElement('div');
          const eyebrow = document.createElement('p');
          eyebrow.className = 'site-faq__eyebrow';
          eyebrow.textContent = 'Buyer questions';
          const title = document.createElement('h2');
          title.className = 'site-faq__heading';
          title.id = section.getAttribute('aria-labelledby');
          title.textContent = heading.textContent;
          const intro = document.createElement('p');
          intro.className = 'site-faq__intro';
          intro.textContent = 'Clear answers to practical questions about this packaging topic.';
          headingBlock.append(eyebrow, title);
          headingGrid.append(headingBlock, intro);

          const panel = document.createElement('div');
          panel.className = 'site-faq__panel';
          const panelHeading = document.createElement('p');
          panelHeading.className = 'site-faq__panel-heading';
          panelHeading.textContent = 'Packaging guide questions';
          const items = document.createElement('div');
          items.className = 'site-faq__items';

          entries.forEach(({ question, answer }) => {
            const details = document.createElement('details');
            details.className = 'site-faq__item';
            const summary = document.createElement('summary');
            summary.className = 'site-faq__summary';
            const questionText = document.createElement('span');
            questionText.className = 'site-faq__question';
            questionText.textContent = question;
            const icon = document.createElement('span');
            icon.className = 'site-faq__icon';
            icon.setAttribute('aria-hidden', 'true');
            icon.textContent = '+';
            const answerText = document.createElement('p');
            answerText.className = 'site-faq__answer';
            answerText.innerHTML = answer;
            summary.append(questionText, icon);
            details.append(summary, answerText);
            items.append(details);
          });

          panel.append(panelHeading, items);
          container.append(headingGrid, panel);
          section.append(container);
          heading.replaceWith(section);
          consumed.forEach((element) => element.remove());
        });
      })();
    </script>
  </body>
</html>
