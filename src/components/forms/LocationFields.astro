---
interface Props {
  compact?: boolean;
  idPrefix?: string;
}

const { compact = false } = Astro.props;

const inputClass = compact
  ? 'h-12 w-full border border-transparent bg-white px-3 pr-11 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent'
  : 'h-14 w-full border border-transparent bg-white px-4 pr-12 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent';
const gridClass = compact ? 'grid min-w-0 gap-2 sm:grid-cols-3' : 'grid gap-3 md:grid-cols-3';
const buttonClass = compact
  ? 'absolute inset-y-0 right-0 grid w-10 place-items-center text-neutral-500'
  : 'absolute inset-y-0 right-0 grid w-12 place-items-center text-neutral-500';
const panelClass =
  'absolute left-0 right-0 z-20 mt-1 hidden max-h-56 overflow-auto rounded-md border border-[#d8cba7] bg-white py-1 shadow-popover';
const shipmentClass = compact
  ? 'h-12 border border-transparent bg-white px-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent sm:col-span-3'
  : 'h-14 border border-transparent bg-white px-4 text-base font-semibold text-neutral-900 placeholder:text-neutral-400 focus:border-accent md:col-span-3';
---
<div class={gridClass} data-location-fields>
  <div class="relative">
    <input required class={inputClass} name="country" placeholder="Select Country" autocomplete="off" aria-label="Country name" data-location-country />
    <button type="button" class={buttonClass} aria-label="Open country list" data-location-country-toggle>
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M5.5 7.5 10 12l4.5-4.5" />
      </svg>
    </button>
    <div class={panelClass} data-location-country-panel></div>
  </div>

  <div class="relative">
    <input required class={inputClass} name="stateProvince" placeholder="Select State / Province" autocomplete="off" aria-label="State or province name" disabled data-location-state />
    <button type="button" class={buttonClass} aria-label="Open state or province list" data-location-state-toggle disabled>
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M5.5 7.5 10 12l4.5-4.5" />
      </svg>
    </button>
    <div class={panelClass} data-location-state-panel></div>
  </div>

  <div class="relative">
    <input required class={inputClass} name="city" placeholder="Select City" autocomplete="off" aria-label="City name" disabled data-location-city />
    <button type="button" class={buttonClass} aria-label="Open city list" data-location-city-toggle disabled>
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M5.5 7.5 10 12l4.5-4.5" />
      </svg>
    </button>
    <div class={panelClass} data-location-city-panel></div>
  </div>

  <input required class={shipmentClass} name="shipmentAddress" placeholder="Shipment Address*" autocomplete="street-address" aria-label="Shipment address" />
</div>

<script type="module">
  const containers = Array.from(document.querySelectorAll('[data-location-fields]'));
  const dataBasePath = '/vendor/csc-data';

  const fetchJSON = async (path) => {
    const response = await fetch(`${dataBasePath}${path}`, {
      headers: { Accept: 'application/json' }
    });
    if (!response.ok) throw new Error(`Failed to load ${path}`);
    return response.json();
  };

  const getCountries = async () => fetchJSON('/countries.json');
  const getStatesOfCountry = async (countryCode) => {
    if (!countryCode) return [];
    try {
      return await fetchJSON(`/states/${countryCode.toUpperCase()}.json`);
    } catch {
      return [];
    }
  };
  const getCitiesOfState = async (countryCode, stateCode) => {
    if (!countryCode || !stateCode) return [];
    try {
      return await fetchJSON(`/cities/${countryCode.toUpperCase()}-${stateCode.toUpperCase()}.json`);
    } catch {
      return [];
    }
  };
  const getAllCitiesOfCountry = async (countryCode) => {
    const countryStates = await getStatesOfCountry(countryCode);
    const cityArrays = await Promise.all(countryStates.map((state) => getCitiesOfState(countryCode, state.iso2)));
    return cityArrays.flat();
  };

  containers.forEach(async (container) => {
    if (!(container instanceof HTMLElement)) return;

    const countryInput = container.querySelector('[data-location-country]');
    const countryToggle = container.querySelector('[data-location-country-toggle]');
    const countryPanel = container.querySelector('[data-location-country-panel]');
    const stateInput = container.querySelector('[data-location-state]');
    const stateToggle = container.querySelector('[data-location-state-toggle]');
    const statePanel = container.querySelector('[data-location-state-panel]');
    const cityInput = container.querySelector('[data-location-city]');
    const cityToggle = container.querySelector('[data-location-city-toggle]');
    const cityPanel = container.querySelector('[data-location-city-panel]');

    if (
      !(countryInput instanceof HTMLInputElement) ||
      !(countryToggle instanceof HTMLButtonElement) ||
      !(countryPanel instanceof HTMLDivElement) ||
      !(stateInput instanceof HTMLInputElement) ||
      !(stateToggle instanceof HTMLButtonElement) ||
      !(statePanel instanceof HTMLDivElement) ||
      !(cityInput instanceof HTMLInputElement) ||
      !(cityToggle instanceof HTMLButtonElement) ||
      !(cityPanel instanceof HTMLDivElement)
    ) {
      return;
    }

    let countries = [];
    let states = [];
    let cities = [];
    let activePanel = null;
    let currentCountryCode = '';
    let currentStateCode = '';
    let countryLoadToken = 0;
    let stateLoadToken = 0;

    const normalize = (value) => String(value || '').trim().toLowerCase();
    const sortByName = (items) => [...items].sort((a, b) => a.name.localeCompare(b.name));

    const closePanel = (panel) => {
      panel.classList.add('hidden');
      if (activePanel === panel) activePanel = null;
    };

    const closeAllPanels = () => {
      closePanel(countryPanel);
      closePanel(statePanel);
      closePanel(cityPanel);
    };

    const setToggleDisabled = (button, disabled) => {
      button.disabled = disabled;
      button.classList.toggle('cursor-not-allowed', disabled);
      button.classList.toggle('opacity-50', disabled);
    };

    const setInputState = (input, button, { disabled, readOnly = false, placeholder, value = '' }) => {
      input.disabled = disabled;
      input.readOnly = readOnly;
      input.placeholder = placeholder;
      input.value = value;
      input.classList.toggle('text-neutral-500', readOnly || disabled);
      setToggleDisabled(button, disabled || readOnly);
    };

    const renderOptions = (panel, items, onSelect) => {
      panel.innerHTML = '';

      if (!items.length) {
        const empty = document.createElement('div');
        empty.className = 'px-3 py-2 text-sm font-semibold text-neutral-500';
        empty.textContent = 'No matching results';
        panel.appendChild(empty);
        panel.classList.remove('hidden');
        activePanel = panel;
        return;
      }

      const fragment = document.createDocumentFragment();
      items.forEach((item) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'block w-full px-3 py-2 text-left text-sm font-semibold text-neutral-700 transition hover:bg-neutral-50 hover:text-neutral-900';
        button.textContent = item.name;
        button.addEventListener('click', () => onSelect(item));
        fragment.appendChild(button);
      });

      panel.appendChild(fragment);
      panel.classList.remove('hidden');
      activePanel = panel;
    };

    const filterItems = (items, value) => {
      const query = normalize(value);
      if (!query) return items;
      return items.filter((item) => normalize(item.name).includes(query));
    };

    const matchByName = (items, value) => {
      const query = normalize(value);
      return items.find((item) => normalize(item.name) === query) || null;
    };

    const clearStateAndCity = () => {
      states = [];
      cities = [];
      currentStateCode = '';
      closePanel(statePanel);
      closePanel(cityPanel);
      setInputState(stateInput, stateToggle, {
        disabled: true,
        placeholder: 'Select State / Province',
        value: ''
      });
      setInputState(cityInput, cityToggle, {
        disabled: true,
        placeholder: 'Select City',
        value: ''
      });
    };

    const enableManualCityFallback = () => {
      cities = [];
      closePanel(cityPanel);
      cityInput.disabled = false;
      cityInput.readOnly = false;
      cityInput.placeholder = 'Enter City Name';
      cityInput.value = '';
      cityInput.classList.remove('text-neutral-500');
      setToggleDisabled(cityToggle, true);
    };

    const selectCity = (city) => {
      cityInput.value = city.name;
      closePanel(cityPanel);
    };

    const loadCitiesForState = async (countryCode, stateCode) => {
      const loadToken = ++stateLoadToken;
      closePanel(cityPanel);
      cityInput.disabled = true;
      cityInput.placeholder = 'Loading cities...';
      cityInput.value = '';
      setToggleDisabled(cityToggle, true);

      try {
        const result = sortByName(await getCitiesOfState(countryCode, stateCode));
        if (loadToken !== stateLoadToken) return;

        cities = result;
        if (cities.length) {
          cityInput.disabled = false;
          cityInput.readOnly = false;
          cityInput.placeholder = 'Select City';
          cityInput.classList.remove('text-neutral-500');
          setToggleDisabled(cityToggle, false);
        } else {
          enableManualCityFallback();
        }
      } catch {
        if (loadToken !== stateLoadToken) return;
        enableManualCityFallback();
      }
    };

    const loadCitiesForCountry = async (countryCode) => {
      const loadToken = ++stateLoadToken;
      closePanel(cityPanel);
      cityInput.disabled = true;
      cityInput.placeholder = 'Loading cities...';
      cityInput.value = '';
      setToggleDisabled(cityToggle, true);

      try {
        const result = sortByName(await getAllCitiesOfCountry(countryCode));
        if (loadToken !== stateLoadToken) return;

        cities = result;
        if (cities.length) {
          cityInput.disabled = false;
          cityInput.readOnly = false;
          cityInput.placeholder = 'Select City';
          cityInput.classList.remove('text-neutral-500');
          setToggleDisabled(cityToggle, false);
        } else {
          enableManualCityFallback();
        }
      } catch {
        if (loadToken !== stateLoadToken) return;
        enableManualCityFallback();
      }
    };

    const selectState = async (state) => {
      stateInput.value = state.name;
      currentStateCode = state.iso2 || '';
      closePanel(statePanel);
      await loadCitiesForState(currentCountryCode, currentStateCode);
    };

    const loadStatesForCountry = async (countryCode) => {
      const loadToken = ++countryLoadToken;
      closePanel(statePanel);
      closePanel(cityPanel);
      currentStateCode = '';
      stateInput.value = '';
      cityInput.value = '';
      stateInput.disabled = true;
      cityInput.disabled = true;
      stateInput.readOnly = false;
      cityInput.readOnly = false;
      stateInput.placeholder = 'Loading states...';
      cityInput.placeholder = 'Select City';
      setToggleDisabled(stateToggle, true);
      setToggleDisabled(cityToggle, true);

      try {
        const result = sortByName(await getStatesOfCountry(countryCode));
        if (loadToken !== countryLoadToken) return;

        states = result;
        if (states.length) {
          stateInput.disabled = false;
          stateInput.placeholder = 'Select State / Province';
          stateInput.classList.remove('text-neutral-500');
          setToggleDisabled(stateToggle, false);
        } else {
          stateInput.disabled = false;
          stateInput.readOnly = true;
          stateInput.value = 'Not Applicable';
          stateInput.placeholder = 'Not Applicable';
          stateInput.classList.add('text-neutral-500');
          setToggleDisabled(stateToggle, true);
          await loadCitiesForCountry(countryCode);
        }
      } catch {
        if (loadToken !== countryLoadToken) return;
        states = [];
        stateInput.disabled = false;
        stateInput.readOnly = true;
        stateInput.value = 'Not Applicable';
        stateInput.placeholder = 'Not Applicable';
        stateInput.classList.add('text-neutral-500');
        setToggleDisabled(stateToggle, true);
        await loadCitiesForCountry(countryCode);
      }
    };

    const selectCountry = async (country) => {
      countryInput.value = country.name;
      currentCountryCode = country.iso2 || '';
      closePanel(countryPanel);
      clearStateAndCity();
      await loadStatesForCountry(currentCountryCode);
    };

    const bindSearchInput = (input, panel, getItems, onSelect) => {
      input.addEventListener('focus', () => {
        if (input.disabled || input.readOnly) return;
        renderOptions(panel, filterItems(getItems(), input.value), onSelect);
      });

      input.addEventListener('input', () => {
        if (input.disabled || input.readOnly) return;
        renderOptions(panel, filterItems(getItems(), input.value), onSelect);
      });

      input.addEventListener('blur', () => {
        window.setTimeout(() => closePanel(panel), 120);
      });
    };

    bindSearchInput(countryInput, countryPanel, () => countries, selectCountry);
    bindSearchInput(stateInput, statePanel, () => states, selectState);
    bindSearchInput(cityInput, cityPanel, () => cities, selectCity);

    countryToggle.addEventListener('click', () => {
      countryInput.focus();
      renderOptions(countryPanel, filterItems(countries, countryInput.value), selectCountry);
    });

    stateToggle.addEventListener('click', () => {
      if (stateToggle.disabled) return;
      stateInput.focus();
      renderOptions(statePanel, filterItems(states, stateInput.value), selectState);
    });

    cityToggle.addEventListener('click', () => {
      if (cityToggle.disabled) return;
      cityInput.focus();
      renderOptions(cityPanel, filterItems(cities, cityInput.value), selectCity);
    });

    countryInput.addEventListener('change', async () => {
      const match = matchByName(countries, countryInput.value);
      if (!match) {
        currentCountryCode = '';
        countryInput.value = '';
        clearStateAndCity();
        return;
      }
      if (match.iso2 !== currentCountryCode) await selectCountry(match);
    });

    stateInput.addEventListener('change', async () => {
      if (stateInput.readOnly) return;
      const match = matchByName(states, stateInput.value);
      if (!match) {
        currentStateCode = '';
        stateInput.value = '';
        cities = [];
        cityInput.value = '';
        cityInput.disabled = true;
        cityInput.placeholder = 'Select City';
        setToggleDisabled(cityToggle, true);
        return;
      }
      if (match.iso2 !== currentStateCode) await selectState(match);
    });

    cityInput.addEventListener('change', () => {
      if (!cities.length || cityToggle.disabled) return;
      const match = matchByName(cities, cityInput.value);
      if (!match) cityInput.value = '';
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node) || container.contains(event.target)) return;
      closeAllPanels();
    });

    setInputState(stateInput, stateToggle, {
      disabled: true,
      placeholder: 'Select State / Province'
    });
    setInputState(cityInput, cityToggle, {
      disabled: true,
      placeholder: 'Select City'
    });

    try {
      countries = sortByName(await getCountries());
      countryInput.placeholder = 'Select Country';
      setToggleDisabled(countryToggle, false);
    } catch {
      countryInput.placeholder = 'Unable to load countries';
      countryInput.disabled = true;
      setToggleDisabled(countryToggle, true);
    }
  });
</script>
