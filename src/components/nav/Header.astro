<script id="site-search-index" type="application/json" set:html={JSON.stringify(searchItems)}></script>

<script>
  type SearchItem = {
    label: string;
    href: string;
    type: string;
    description: string;
    keywords: string;
  };

  const normalizeSearchText = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  const indexElement = document.querySelector<HTMLScriptElement>('#site-search-index');
  const searchIndex: SearchItem[] = indexElement?.textContent ? JSON.parse(indexElement.textContent) : [];

  document.querySelectorAll<HTMLFormElement>('[data-site-search]').forEach((form) => {
    if (form.dataset.searchReady === 'true') return;
    form.dataset.searchReady = 'true';

    const input = form.querySelector<HTMLInputElement>('input[name="q"]');
    const results = form.querySelector<HTMLElement>('[data-search-results]');
    if (!input || !results) return;

    let visibleItems: SearchItem[] = [];
    let activeIndex = -1;

    const closeResults = () => {
      results.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
    };

    const setActiveResult = (nextIndex: number) => {
      const links = [...results.querySelectorAll<HTMLAnchorElement>('[data-search-result]')];
      if (!links.length) return;
      activeIndex = (nextIndex + links.length) % links.length;
      links.forEach((link, index) => {
        link.dataset.active = index === activeIndex ? 'true' : 'false';
        link.setAttribute('aria-selected', index === activeIndex ? 'true' : 'false');
      });
      links[activeIndex]?.scrollIntoView({ block: 'nearest' });
    };

    const findMatches = (query: string) => {
      const normalizedQuery = normalizeSearchText(query);
      if (!normalizedQuery) return searchIndex.slice(0, 7);
      const queryWords = normalizedQuery.split(' ');

      return searchIndex
        .map((item) => {
          const label = normalizeSearchText(item.label);
          const searchable = normalizeSearchText(`${item.label} ${item.type} ${item.description} ${item.keywords}`);
          if (!queryWords.every((word) => searchable.includes(word))) return null;

          let score = 0;
          if (label === normalizedQuery) score += 100;
          if (label.startsWith(normalizedQuery)) score += 60;
          if (label.includes(normalizedQuery)) score += 35;
          score += queryWords.filter((word) => label.includes(word)).length * 12;
          return { item, score };
        })
        .filter((match): match is { item: SearchItem; score: number } => match !== null)
        .sort((a, b) => b.score - a.score || a.item.label.localeCompare(b.item.label))
        .slice(0, 8)
        .map((match) => match.item);
    };

    const renderResults = () => {
      visibleItems = findMatches(input.value);
      activeIndex = -1;
      results.replaceChildren();

      const heading = document.createElement('div');
      heading.className = 'site-search-heading';
      heading.textContent = input.value.trim() ? 'Search results' : 'Popular packaging';
      results.append(heading);

      if (!visibleItems.length) {
        const empty = document.createElement('div');
        empty.className = 'site-search-empty';
        empty.innerHTML = '<strong>No matching packaging found.</strong><span>Try a product, material, or box style.</span>';
        results.append(empty);

        const browse = document.createElement('a');
        browse.className = 'site-search-browse';
        browse.href = '/industries';
        browse.textContent = 'Browse all packaging categories →';
        results.append(browse);
      } else {
        visibleItems.forEach((item) => {
          const link = document.createElement('a');
          link.href = item.href;
          link.dataset.searchResult = 'true';
          link.className = 'site-search-result';
          link.setAttribute('role', 'option');
          link.setAttribute('aria-selected', 'false');

          const copy = document.createElement('span');
          copy.className = 'site-search-result-copy';
          const label = document.createElement('strong');
          label.textContent = item.label;
          const description = document.createElement('span');
          description.textContent = item.description;
          copy.append(label, description);

          const type = document.createElement('span');
          type.className = 'site-search-result-type';
          type.textContent = item.type;
          link.append(copy, type);
          results.append(link);
        });
      }

      results.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    input.addEventListener('focus', renderResults);
    input.addEventListener('input', renderResults);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (results.hidden) renderResults();
        setActiveResult(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (results.hidden) renderResults();
        setActiveResult(activeIndex - 1);
      } else if (event.key === 'Enter' && activeIndex >= 0) {
        event.preventDefault();
        const activeItem = visibleItems[activeIndex];
        if (activeItem) window.location.assign(activeItem.href);
      } else if (event.key === 'Escape') {
        closeResults();
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const matches = findMatches(input.value);
      if (input.value.trim() && matches[0]) {
        window.location.assign(matches[0].href);
      } else {
        renderResults();
      }
    });

    document.addEventListener('pointerdown', (event) => {
      if (!form.contains(event.target as Node)) closeResults();
    });
  });
</script>

