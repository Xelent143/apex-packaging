---
interface Props {
  heading?: string;
  eyebrow?: string;
  intro?: string;
  variant?: 'default' | 'rfq';
  faqs: Array<{ q: string; a: string }>;
}
const {
  heading = 'Frequently asked',
  eyebrow,
  intro,
  variant = 'default',
  faqs
} = Astro.props;
const isRfq = variant === 'rfq';
---
<section class:list={["py-12 md:py-28", isRfq && "bg-[#fffdf8] md:py-24"]}>
  <div class:list={["container", isRfq ? "max-w-wide" : "max-w-default"]}>
    <div class:list={[isRfq && "mb-8 grid gap-5 lg:grid-cols-12 lg:items-end md:mb-10"]}>
      <div class:list={[isRfq && "lg:col-span-8"]}>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2 class:list={[
          "font-display text-3xl font-bold leading-[1.05] text-neutral-900 md:text-5xl",
          isRfq ? "mt-3 max-w-5xl font-extrabold uppercase" : "mb-7 md:mb-10"
        ]}>{heading}</h2>
      </div>
      {intro && (
        <p class="max-w-2xl text-base leading-relaxed text-neutral-600 md:text-lg lg:col-span-4 lg:justify-self-end">
          {intro}
        </p>
      )}
    </div>
    <div class:list={[
      "divide-y divide-neutral-200 overflow-hidden bg-white",
      isRfq
        ? "rounded-[2rem] rounded-tr-[3.75rem] border border-[#d8cba7] shadow-popover"
        : "rounded-md border border-neutral-200 md:rounded-none md:border-x-0"
    ]}>
      {isRfq && (
        <div class="bg-[#c99700] px-5 py-4 md:px-8 md:py-5">
          <p class="font-display text-sm font-extrabold uppercase tracking-[0.16em] text-neutral-950 md:text-base">Custom packaging buyer questions</p>
        </div>
      )}
      {faqs.map((faq) => (
        <details class:list={["group", isRfq && "transition-colors open:bg-[#f6f1e7]"]}>
          <summary class:list={[
            "flex min-h-[4.25rem] cursor-pointer list-none items-start justify-between gap-4 px-4 py-5",
            isRfq ? "md:min-h-[5.5rem] md:px-8 md:py-7" : "md:px-0"
          ]}>
            <span class:list={[
              "font-display text-base font-semibold text-neutral-900 transition-colors group-hover:text-accent md:text-xl",
              isRfq && "md:text-2xl"
            ]}>{faq.q}</span>
            <span
              class:list={[
                "mt-0.5 grid flex-none place-items-center font-mono text-xl text-accent transition-all group-open:rotate-45 md:mt-1",
                isRfq && "h-8 w-8 rounded-full bg-[#f6f1e7] group-hover:bg-[#c99700] group-hover:text-neutral-950 group-open:bg-[#c99700] group-open:text-neutral-950"
              ]}
              aria-hidden="true"
            >+</span>
          </summary>
          <p class:list={[
            "max-w-3xl px-4 pb-5 text-[0.9375rem] leading-relaxed text-neutral-600",
            isRfq ? "md:px-8 md:pb-7 md:text-base" : "md:px-0"
          ]}>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
