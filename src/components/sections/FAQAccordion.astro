---
interface Props {
  heading?: string;
  eyebrow?: string;
  intro?: string;
  panelHeading?: string;
  embedded?: boolean;
  variant?: 'default' | 'rfq';
  faqs: Array<{ q: string; a: string }>;
}
const {
  heading = 'Frequently asked questions',
  eyebrow = 'Buyer questions',
  intro = 'Straight answers to the questions buyers ask before requesting a custom packaging quotation.',
  variant = 'default',
  embedded = false,
  faqs
} = Astro.props;
const panelHeading = Astro.props.panelHeading ?? (variant === 'rfq' ? 'Custom packaging buyer questions' : 'Packaging buyer questions');
---
<section class:list={["site-faq", embedded && "site-faq--embedded"]}>
  <div class="site-faq__container">
    <div class="site-faq__heading-grid">
      <div>
        <p class="site-faq__eyebrow">{eyebrow}</p>
        <h2 class="site-faq__heading">{heading}</h2>
      </div>
      <p class="site-faq__intro">{intro}</p>
    </div>
    <div class="site-faq__panel">
      <p class="site-faq__panel-heading">{panelHeading}</p>
      <div class="site-faq__items">
        {faqs.map((faq) => (
          <details class="site-faq__item">
            <summary class="site-faq__summary">
              <span class="site-faq__question">{faq.q}</span>
              <span class="site-faq__icon" aria-hidden="true">+</span>
            </summary>
            <p class="site-faq__answer">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
