---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../sections/PageHeader.astro';
import { buildArticleSchema, buildBreadcrumbSchema } from '../../lib/schema';

type Metric = { value: string; label: string };
type Section = { kicker: string; title: string; paragraphs: string[] };
type TableData = { title: string; intro: string; columns: string[]; rows: string[][]; note?: string };
type Reference = { label: string; href: string };
interface Props {
  title: string; description: string; url: string; date: string; dateISO: string; eyebrow: string; lead: string;
  hero: string; heroAlt: string; support: string; supportAlt: string; supportCaption: string;
  intro: string; rule: string; metrics: Metric[]; sections: Section[]; table: TableData;
  checklistTitle: string; checklist: string[]; references: Reference[]; relatedHref: string; relatedLabel: string;
}
const p = Astro.props;
const article = buildArticleSchema({ title: p.title, description: p.description, url: p.url, datePublished: p.dateISO, author: 'Apex Packaging Solutions', image: p.hero });
const breadcrumb = buildBreadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Packaging Guides', url: '/blog' }, { name: p.title, url: p.url }]);
---

<BaseLayout title={p.title} description={p.description} image={p.hero} schemaBlocks={[breadcrumb, article]}>
  <PageHeader eyebrow={p.eyebrow} heading={p.title} lead={p.lead} imageSrc={p.hero} imageAlt={p.heroAlt} />
  <main>
    <section class="guide-intro"><div class="guide-shell intro-grid">
      <div><p class="meta">BUYER GUIDE · {p.date} · PRACTICAL DECISION TOOL</p><p class="standfirst">{p.intro}</p></div>
      <aside><span>THE DECISION RULE</span><p>{p.rule}</p></aside>
    </div></section>

    <section class="metric-band"><div class="guide-shell metric-grid">
      {p.metrics.map((m) => <div><strong>{m.value}</strong><span>{m.label}</span></div>)}
    </div></section>

    <section class="content-band"><div class="guide-shell split-grid">
      <div class="copy"><p class="kicker">{p.sections[0].kicker}</p><h2>{p.sections[0].title}</h2>{p.sections[0].paragraphs.map((x) => <p>{x}</p>)}</div>
      <figure><img src={p.support} alt={p.supportAlt} width="1672" height="941" loading="lazy" decoding="async" /><figcaption>{p.supportCaption}</figcaption></figure>
    </div></section>

    <section class="table-band"><div class="guide-shell">
      <p class="kicker light">WORKED EXAMPLE</p><h2>{p.table.title}</h2><p class="table-intro">{p.table.intro}</p>
      <div class="table-wrap"><table><thead><tr>{p.table.columns.map((c) => <th>{c}</th>)}</tr></thead><tbody>{p.table.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody></table></div>
      {p.table.note && <p class="table-note">{p.table.note}</p>}
    </div></section>

    <section class="content-band muted"><div class="guide-shell section-pair">
      {p.sections.slice(1,3).map((s, i) => <article><span class="number">0{i + 2}</span><p class="kicker">{s.kicker}</p><h2>{s.title}</h2>{s.paragraphs.map((x) => <p>{x}</p>)}</article>)}
    </div></section>

    <section class="check-band"><div class="guide-shell check-grid">
      <div><p class="kicker">RELEASE CONTROL</p><h2>{p.checklistTitle}</h2><p>Keep the decision with the specification, named sample and purchase record so the next order does not restart from memory.</p></div>
      <div class="checklist" role="list">{p.checklist.map((x) => <p role="listitem">{x}</p>)}</div>
    </div></section>

    <section class="source-band"><div class="guide-shell source-grid">
      <div><p class="kicker light">SOURCE NOTES</p><h2>Use current requirements for the actual project</h2><p>These references support the decision framework. Supplier capabilities, carrier rules, retailer requirements and acceptance limits must be confirmed for the individual order.</p></div>
      <div class="source-links">{p.references.map((r) => <a href={r.href}>{r.label}<span>↗</span></a>)}</div>
    </div></section>

    <section class="guide-cta"><div class="guide-shell cta-grid"><div><p class="kicker light">NEXT STEP</p><h2>Bring the numbers into the packaging brief</h2><p>Apex Packaging Solutions coordinates custom packaging design, sampling, overseas production and delivery for Canadian and US buyers.</p></div><div><a href="/contact">Discuss your project <span>→</span></a><a class="secondary" href={p.relatedHref}>{p.relatedLabel}</a></div></div></section>
  </main>
</BaseLayout>

<style>
  .guide-shell{width:min(1180px,calc(100% - 40px));margin-inline:auto}.guide-intro,.content-band,.check-band{padding:72px 0}.intro-grid,.split-grid,.section-pair,.check-grid,.source-grid,.cta-grid{display:grid;gap:52px}.intro-grid{grid-template-columns:1.35fr .65fr}.meta,.kicker,.intro-grid aside span{margin:0 0 14px;color:#a97700;font-size:.74rem;font-weight:900;letter-spacing:.14em}.standfirst{margin:0;font-size:clamp(1.25rem,2.5vw,1.65rem);line-height:1.55;color:#282522}.intro-grid aside{border-left:4px solid #c89200;padding:8px 0 8px 26px}.intro-grid aside p{margin:0;color:#49443e;font-size:1.05rem;line-height:1.65}.metric-band{background:#111;color:#fff}.metric-grid{display:grid;grid-template-columns:repeat(3,1fr)}.metric-grid div{padding:34px 28px;border-left:1px solid #3c3c3c}.metric-grid div:last-child{border-right:1px solid #3c3c3c}.metric-grid strong{display:block;color:#d2a019;font-size:clamp(1.8rem,4vw,3rem);line-height:1}.metric-grid span{display:block;margin-top:10px;color:#d6d2ca}.split-grid{grid-template-columns:.88fr 1.12fr;align-items:center}.copy h2,.section-pair h2,.check-grid h2,.source-grid h2,.guide-cta h2,.table-band h2{margin:0 0 22px;font-size:clamp(2rem,3.6vw,3.15rem);line-height:1.08;letter-spacing:0}.copy p,.section-pair article>p:last-child,.section-pair article>p:nth-last-child(2),.check-grid>div>p,.source-grid>div>p,.guide-cta p{color:#4b4640;font-size:1.04rem;line-height:1.75}.split-grid figure{margin:0;border:1px solid #ddd7ce;background:#fff}.split-grid img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.split-grid figcaption{padding:14px 18px;color:#675f57;font-size:.86rem}.table-band{padding:72px 0;background:#ae7d00;color:#fff}.light{color:#fff0bd}.table-band h2{color:#fff}.table-intro,.table-note{max-width:860px;color:#fff5d9;line-height:1.7}.table-wrap{margin-top:30px;overflow-x:auto;border:1px solid rgba(255,255,255,.55)}table{width:100%;min-width:680px;border-collapse:collapse}th,td{padding:16px 18px;text-align:left;border-right:1px solid rgba(255,255,255,.35);border-bottom:1px solid rgba(255,255,255,.35)}th{background:#111;color:#fff;font-size:.76rem;letter-spacing:.08em;text-transform:uppercase}td{color:#fff;background:rgba(255,255,255,.04)}.muted{background:#f3f1ed}.section-pair{grid-template-columns:repeat(2,1fr)}.section-pair article{position:relative;padding-top:46px;border-top:3px solid #111}.number{position:absolute;top:12px;right:0;color:#c89200;font-weight:900}.check-grid{grid-template-columns:.75fr 1.25fr}.checklist{border-top:3px solid #c89200}.checklist p{position:relative;margin:0;padding:17px 16px 17px 44px;border-bottom:1px solid #d9d3ca;color:#302d29}.checklist p::before{content:'✓';position:absolute;left:14px;color:#a97700;font-weight:900}.source-band{padding:64px 0;background:#272522;color:#fff}.source-grid{grid-template-columns:1fr 1fr}.source-grid h2{color:#fff}.source-grid>div>p{color:#d3cec6}.source-links{border-top:1px solid #5d5953}.source-links a{display:flex;justify-content:space-between;gap:20px;padding:18px 4px;border-bottom:1px solid #5d5953;color:#fff;text-decoration:none}.source-links span{color:#d2a019}.guide-cta{padding:68px 0;background:#111;color:#fff}.cta-grid{grid-template-columns:1fr auto;align-items:center}.guide-cta h2{color:#fff}.guide-cta p{color:#cbc6bd}.cta-grid>div:last-child{display:grid;gap:12px;min-width:250px}.cta-grid a{display:flex;justify-content:space-between;gap:20px;padding:16px 18px;background:#c89200;color:#111;font-weight:900;text-decoration:none}.cta-grid .secondary{background:transparent;border:1px solid #777;color:#fff;font-weight:700}@media(max-width:850px){.intro-grid,.split-grid,.section-pair,.check-grid,.source-grid,.cta-grid{grid-template-columns:1fr}.metric-grid{grid-template-columns:1fr}.metric-grid div,.metric-grid div:last-child{border-right:0;border-left:0;border-bottom:1px solid #3c3c3c}.split-grid figure{order:2}.cta-grid>div:last-child{min-width:0;max-width:360px}}@media(max-width:560px){.guide-shell{width:min(100% - 28px,1180px)}.guide-intro,.content-band,.check-band,.table-band{padding:48px 0}.metric-grid div{padding:24px 14px}.copy h2,.section-pair h2,.check-grid h2,.source-grid h2,.guide-cta h2,.table-band h2{font-size:2rem}}
</style>
